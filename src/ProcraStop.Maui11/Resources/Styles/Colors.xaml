<?xml version="1.0" encoding="UTF-8" ?>
<!-- Design System ProcraStop · tokens de color light/dark.
     Fuente: skill procra-uiux → references/design-system.md §2.
     Convención (igual que la app .NET 10): cada token tiene dos claves
     `<Token>Light` y `<Token>Dark`; los consumidores las unen con
     {AppThemeBinding Light={StaticResource X}Dark}, porque Color no admite
     AppThemeBinding como contenido (XAMLC: no ContentProperty). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Acción / foco -->
    <Color x:Key="PrimaryLight">#4075FF</Color>
    <Color x:Key="PrimaryDark">#6590FF</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainerLight">#D9E3FF</Color>
    <Color x:Key="PrimaryContainerDark">#1F2845</Color>
    <Color x:Key="OnPrimaryContainerLight">#1F2845</Color>
    <Color x:Key="OnPrimaryContainerDark">#D9E2FF</Color>

    <!-- Superficies -->
    <Color x:Key="SurfaceLight">#F1F3F8</Color>
    <Color x:Key="SurfaceDark">#222631</Color>
    <Color x:Key="SurfaceContainerLight">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerDark">#171B24</Color>
    <Color x:Key="SurfaceContainerHighLight">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerHighDark">#1F2430</Color>
    <Color x:Key="TabBarLight">#FFFFFF</Color>
    <Color x:Key="TabBarDark">#131821</Color>
    <Color x:Key="OutlineLight">#DBE0ED</Color>
    <Color x:Key="OutlineDark">#333949</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryLight">#12141B</Color>
    <Color x:Key="TextPrimaryDark">#FEFFFF</Color>
    <Color x:Key="TextSecondaryLight">#6F7A8F</Color>
    <Color x:Key="TextSecondaryDark">#AAB0C0</Color>
    <Color x:Key="TextTertiaryLight">#9CA3AF</Color>
    <Color x:Key="TextTertiaryDark">#6B7280</Color>
    <Color x:Key="TextDisabledLight">#B0B7CA</Color>
    <Color x:Key="TextDisabledDark">#8F94A7</Color>

    <!-- Semánticos -->
    <Color x:Key="SuccessLight">#46C771</Color>
    <Color x:Key="SuccessDark">#5BD78B</Color>
    <Color x:Key="SuccessContainerLight">#E4F8EC</Color>
    <Color x:Key="SuccessContainerDark">#1E3328</Color>
    <Color x:Key="WarningLight">#F59E0B</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="ErrorLight">#E5484D</Color>
    <Color x:Key="ErrorDark">#FF6B6E</Color>
    <Color x:Key="ErrorContainerLight">#FDE8E9</Color>
    <Color x:Key="ErrorContainerDark">#3A1F22</Color>
    <Color x:Key="InfoLight">#4075FF</Color>
    <Color x:Key="InfoDark">#6590FF</Color>

    <!-- Capas flotantes -->
    <Color x:Key="ScrimLight">#14000000</Color>
    <Color x:Key="ScrimDark">#40000000</Color>
    <!-- Scrim de modales (Material: 32% negro en light, ~60% en dark) -->
    <Color x:Key="ModalScrimLight">#52000000</Color>
    <Color x:Key="ModalScrimDark">#99000000</Color>
</ResourceDictionary>
