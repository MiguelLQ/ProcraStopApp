<?xml version="1.0" encoding="UTF-8" ?>
<!-- Design System ProcraStop · escala de espaciado (base 4-pt).
     Fuente: skill procra-uiux → references/design-system.md §4. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">20</x:Double>
    <x:Double x:Key="SpacingXXL">24</x:Double>
    <x:Double x:Key="SpacingScreen">20</x:Double>
    <x:Double x:Key="SpacingScreenBottom">32</x:Double>

    <!-- Margen lateral estándar de toda página -->
    <Thickness x:Key="ScreenMargin">20,12,20,0</Thickness>

    <!-- Margen inferior estándar de card dentro de listas (SpacingM) -->
    <Thickness x:Key="CardMargin">0,0,0,12</Thickness>

    <!-- Padding interno estándar de card (SpacingL) -->
    <Thickness x:Key="CardPadding">16</Thickness>
</ResourceDictionary>
