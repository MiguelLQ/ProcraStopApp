<?xml version="1.0" encoding="UTF-8" ?>
<!-- Design System ProcraStop · estilos implícitos (look por defecto). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceLight}" Dark="{StaticResource SurfaceDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="{StaticResource ScreenMargin}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceLight}" Dark="{StaticResource SurfaceDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.ForegroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.TitleColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.DisabledColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextDisabledLight}" Dark="{StaticResource TextDisabledDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.UnselectedColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextTertiaryLight}" Dark="{StaticResource TextTertiaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TabBarLight}" Dark="{StaticResource TabBarDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.TabBarTitleColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.TabBarUnselectedColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextTertiaryLight}" Dark="{StaticResource TextTertiaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shell.TabBarForegroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource OutlineLight}" Dark="{StaticResource OutlineDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource OutlineLight}" Dark="{StaticResource OutlineDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="PlaceholderColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextDisabledLight}" Dark="{StaticResource TextDisabledDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="PlaceholderColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextDisabledLight}" Dark="{StaticResource TextDisabledDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
