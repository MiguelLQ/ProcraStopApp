<?xml version="1.0" encoding="UTF-8" ?>
<!-- Design System ProcraStop · estilos con clave para componentes.
     Fuente: skill procra-uiux → references/components.md. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Botones ===== -->
    <Style x:Key="PSButtonPrimaryStyle" TargetType="Button">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PSButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource PSButtonPrimaryStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryContainerLight}" Dark="{StaticResource PrimaryContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource OnPrimaryContainerLight}" Dark="{StaticResource OnPrimaryContainerDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PSButtonDestructiveStyle" TargetType="Button" BasedOn="{StaticResource PSButtonPrimaryStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource ErrorLight}" Dark="{StaticResource ErrorDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
    </Style>

    <Style x:Key="PSButtonTextStyle" TargetType="Button" BasedOn="{StaticResource PSButtonPrimaryStyle}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ===== Cards ===== -->
    <Style x:Key="PSCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceContainerLight}" Dark="{StaticResource SurfaceContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource CardMargin}" />
    </Style>

    <Style x:Key="PSCardHeroStyle" TargetType="Border" BasedOn="{StaticResource PSCardStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryContainerLight}" Dark="{StaticResource PrimaryContainerDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Chips ===== -->
    <Style x:Key="PSChipStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceContainerLight}" Dark="{StaticResource SurfaceContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ===== IconButton (tap target 48x48) ===== -->
    <Style x:Key="PSIconButtonStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceContainerLight}" Dark="{StaticResource SurfaceContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== FAB (botón flotante de acción, ej. + Agregar) ===== -->
    <Style x:Key="PSFabStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryLight}" Dark="{StaticResource PrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource ModalScrimLight}"
                        Opacity="0.35" Offset="0,4" Radius="10" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Badges (no interactivos; variantes semánticas) ===== -->
    <Style x:Key="PSBadgePrimaryStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource PrimaryContainerLight}" Dark="{StaticResource PrimaryContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="PSBadgeSuccessStyle" TargetType="Border" BasedOn="{StaticResource PSBadgePrimaryStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SuccessContainerLight}" Dark="{StaticResource SuccessContainerDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PSBadgeWarningStyle" TargetType="Border" BasedOn="{StaticResource PSBadgePrimaryStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource WarningContainerLight}" Dark="{StaticResource WarningContainerDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PSBadgeErrorStyle" TargetType="Border" BasedOn="{StaticResource PSBadgePrimaryStyle}">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource ErrorContainerLight}" Dark="{StaticResource ErrorContainerDark}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="PSInputStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextPrimaryLight}" Dark="{StaticResource TextPrimaryDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="PlaceholderColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource TextDisabledLight}" Dark="{StaticResource TextDisabledDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="PSInputFrameStyle" TargetType="Border">
        <Setter Property="BackgroundColor">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource SurfaceContainerLight}" Dark="{StaticResource SurfaceContainerDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Stroke">
            <Setter.Value>
                <AppThemeBinding Light="{StaticResource OutlineLight}" Dark="{StaticResource OutlineDark}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="{StaticResource SpacingM}" />
    </Style>
</ResourceDictionary>
