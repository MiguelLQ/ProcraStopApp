<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProcraStop.Maui11.ViewModels.Tasks"
             xmlns:components="clr-namespace:ProcraStop.Maui11.Components.Buttons"
             xmlns:sheets="clr-namespace:ProcraStop.Maui11.Components.Sheets"
             x:Class="ProcraStop.Maui11.Views.Tasks.TasksPage"
             x:DataType="vm:TasksPageViewModel"
             x:Name="PageRoot"
             Title="Tareas">

    <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpacingXL}" >

        <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource SpacingXS}" Margin="15,0,15,0">
            <Label Style="{StaticResource HeadlineLargeStyle}" Text="Mis tareas" />
            <Label Style="{StaticResource BodySmallStyle}" Text="Organiza tu día por prioridad y fecha." />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Margin="15,0,15,0"
                Style="{StaticResource PSCardStyle}"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="{StaticResource SpacingS}">
                <Label Style="{StaticResource TitleMediumStyle}" Text="Lista de tareas en construcción" />
                <Label Style="{StaticResource BodyMediumStyle}"
                       Text="Aquí verás tus tarjetas de tarea con filtros, checks y recordatorios de vencimiento." />
            </VerticalStackLayout>
        </Border>

        <!-- FAB flotante inferior derecho "+" (abre el Bottom Sheet de agregar) -->
        <components:PSFab Grid.Row="1"
                          HorizontalOptions="End"
                          VerticalOptions="End"
                          Margin="0,0,15,5"
                          Command="{Binding OpenAddSheetCommand}"
                          SemanticProperties.Description="Agregar tarea" />

        <!-- Bottom Sheet "Agregar" embebido (último hijo = capa superior).
             IsOpen vive en AddSheetViewModel; el overlay lo lee de su
             BindingContext (ver PSAddSheet.xaml). -->
        <sheets:PSAddSheet Grid.RowSpan="2"
                           BindingContext="{Binding AddSheet}" />
    </Grid>
</ContentPage>
