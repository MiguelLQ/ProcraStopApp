<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProcraStop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:task="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Views"
    xmlns:course="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Views.CoursesView"
    Shell.FlyoutBehavior="Flyout"
    Title="ProcraStop">

    <ShellContent
        Title="home"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate task:TaskListPage}"
        Route="task" />
        
    <ShellContent
        Title="Detail"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate task:TaskDetailPage}"
        Route="TaskDetailPage" />
    
    <ShellContent
        Title="Manage Meta"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate task:CalendarPage}"
        Route="CalendarPage" />
    <ShellContent
        Title="Task Page"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate task:TasksPage}"
        Route="TasksPage" />
    <ShellContent
        Title="Cursos"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate course:CoursesPage}"
        Route="CoursesPage" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>
</Shell>
