<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProcraStop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:task="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Views"
    xmlns:course="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Views.CoursesView"
    Shell.FlyoutBehavior="Flyout"
     FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource shellDark}}"
     Shell.TabBarBackgroundColor="{AppThemeBinding Light=#f2f3f8, Dark=#131821}"
    Shell.TabBarForegroundColor="{StaticResource primarioS}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
    Shell.TabBarTitleColor="{StaticResource primarioS}"
    Title="ProcraStop">

    <!-- ROOT LAYOUT -->
    <Shell.Resources>
        <!-- aquí puedes meter estilos si quieres -->
    </Shell.Resources>
    <!-- ===================== -->
    <!-- TABBAR (MÓDULOS) -->
    <!-- ===================== -->

    <!-- HEADER -->
    <Shell.FlyoutHeader>
        <Grid Padding="24,52,24,24"
              BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark=#1C1C2E}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    WidthRequest="56" HeightRequest="56"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource primarioS}"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Start">
                <Label Text="PS" FontSize="20" FontFamily="InterSemiBold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label Grid.Row="1" Text="ProcraStop"
                   FontSize="25" FontFamily="InterRegular"
                   Margin="0,12,0,2"
                   TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"/>

            <Label Grid.Row="2"
                   Text="Organiza · Enfócate · Avanza"
                   FontSize="12" FontFamily="InterRegular"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>

            <BoxView Grid.Row="3"
                     HeightRequest="1" Margin="0,20,0,0"
                     BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2D2D44}"/>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- MÓDULO TAREAS — contiene TabBar con Tareas y Cursos -->
    <FlyoutItem Title="Tareas"
                Icon="{StaticResource IconDashboard}">

        <Tab Title="Tareas" Icon="{StaticResource IconDashboard}">
            <ShellContent
                Title="Tareas"
                ContentTemplate="{DataTemplate task:TasksPage}"
                Route="TasksPage"/>
        </Tab>

        <Tab Title="Cursos" Icon="{StaticResource IconProjects}">
            <ShellContent
                Title="Cursos"
                ContentTemplate="{DataTemplate course:CoursesPage}"
                Route="CoursesPage"/>
        </Tab>
        <Tab Title="Dashboard" Icon="{StaticResource IconDashboard}">
            <ShellContent
                Title="Dashboard"
                ContentTemplate="{DataTemplate task:DashboardPage}"
                Route="DashboardPage"/>
        </Tab>
    </FlyoutItem>

    <!-- MÓDULO FUTURO — Configuración u otro -->
    <FlyoutItem Title="Configuración"
                Icon="{StaticResource IconRibbon}">
        <ShellContent
            Title="Configuración"
            Route="SettingsPage">
            <!-- ContentTemplate="{DataTemplate settings:SettingsPage}" -->
            <ShellContent.ContentTemplate>
                <DataTemplate>
                    <ContentPage Title="Configuración">
                        <Label Text="Próximamente"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"/>
                    </ContentPage>
                </DataTemplate>
            </ShellContent.ContentTemplate>
        </ShellContent>
    </FlyoutItem>
       <!-- FOOTER -->
    <Shell.FlyoutFooter>
        <Grid Padding="24,16"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#131821}">

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2D2D44}"
                     HorizontalOptions="Fill"
                     VerticalOptions="Start"/>

            <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Apariencia"
                           FontSize="13" FontFamily="InterSemiBold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}"/>
                    <Label Text="Cambia el tema"
                           FontSize="11" FontFamily="InterRegular"
                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"/>
                </VerticalStackLayout>

                <sf:SfSegmentedControl Grid.Column="1"
                    x:Name="ThemeSegmentedControl"
                    VerticalOptions="Center"
                    SelectionChanged="SfSegmentedControl_SelectionChanged"
                    SegmentWidth="36" SegmentHeight="36">
                    <sf:SfSegmentedControl.ItemsSource>
                        <x:Array Type="{x:Type sf:SfSegmentItem}">
                            <sf:SfSegmentItem ImageSource="{StaticResource IconLight}"
                                             SemanticProperties.Description="Light mode"/>
                            <sf:SfSegmentItem ImageSource="{StaticResource IconDark}"
                                             SemanticProperties.Description="Dark mode"/>
                        </x:Array>
                    </sf:SfSegmentedControl.ItemsSource>
                </sf:SfSegmentedControl>
            </Grid>
        </Grid>
    </Shell.FlyoutFooter>
</Shell>
