<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Dashboard.Presentation.Views.DashboardView"
             xmlns:stress="clr-namespace:ProcraStop.Modules.Stress.Presentation.Views"
             xmlns:conv="clr-namespace:ProcraStop.Modules.Dashboard.Presentation.Converters"
             Title="DashboardView">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <stress:StressCheckInView/>

            <!-- ========================= -->
            <!-- HERO / CORE STATE -->
            <!-- ========================= -->

            <Border Padding="16" BackgroundColor="{StaticResource DarkSecondaryBackground}">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                    <Label Text="Sistema" Style="{StaticResource SubtitleLabel}" />

                    <Label Grid.Row="1"
                           Text="{Binding Message}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{Binding StateColor}" />

                    <Label Grid.Row="2"
                           Text="{Binding Reason}"
                           Style="{StaticResource SubtitleLabel}" />

                    <Label Grid.Row="3"
                           Text="{Binding SuggestedAction}"
                           TextColor="{StaticResource primarioS}"
                           FontSize="13"/>

                </Grid>

            </Border>
            <!-- ===================== -->
            <!-- SYSTEM STATE -->
            <!-- ===================== -->

            <!-- SYSTEM STATE -->
            <Border Padding="16" BackgroundColor="{StaticResource DarkSecondaryBackground}">

                <VerticalStackLayout Spacing="16">

                    <Label Text="System Health"
                           Style="{StaticResource SubtitleLabel}" />

                    <!-- PERFORMANCE -->
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Performance"/>
                            <Label Text="{Binding SystemState.PerformanceHealth, StringFormat='{0:P0}'}"
                                   TextColor="{StaticResource primarioS}"/>
                        </Grid>

                        <Grid HeightRequest="6">
                            <Border BackgroundColor="{StaticResource secondaryS}"/>
                            <Border BackgroundColor="{StaticResource primarioS}"
                                    WidthRequest="{Binding SystemState.PerformanceHealth, Converter={StaticResource ProgressToWidthConverter}}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- HABITS -->
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Habits"/>
                            <Label Text="{Binding SystemState.BehavioralStability, StringFormat='{0:P0}'}"
                                   TextColor="{StaticResource saveButton}"/>
                        </Grid>

                        <Grid HeightRequest="6">
                            <Border BackgroundColor="{StaticResource secondaryS}"/>
                            <Border BackgroundColor="{StaticResource saveButton}"
                                    WidthRequest="{Binding SystemState.BehavioralStability, Converter={StaticResource ProgressToWidthConverter}}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- STRESS -->
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Stress"/>
                            <Label Text="{Binding SystemState.StressPressure, StringFormat='{0:P0}'}"
                                   TextColor="{StaticResource CancelButton}"/>
                        </Grid>

                        <Grid HeightRequest="6">
                            <Border BackgroundColor="{StaticResource secondaryS}"/>
                            <Border BackgroundColor="{StaticResource CancelButton}"
                                    WidthRequest="{Binding SystemState.StressPressure, Converter={StaticResource ProgressToWidthConverter}}"/>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>
            <!-- ===================== -->
            <!-- SIGNALS -->
            <!-- ===================== -->

            <CollectionView ItemsSource="{Binding Signals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" BackgroundColor="{StaticResource DarkSecondaryBackground}">
                            <VerticalStackLayout>

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Score, StringFormat='{0:P0}'}"
                                           TextColor="{StaticResource primarioS}"/>
                                </Grid>

                                <Grid HeightRequest="6">
                                    <Border BackgroundColor="{StaticResource secondaryS}"/>
                                    <Border BackgroundColor="{StaticResource primarioS}"
                                            WidthRequest="{Binding Score, Converter={StaticResource ProgressToWidthConverter}}"/>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ===================== -->
            <!-- INSIGHTS -->
            <!-- ===================== -->

            <Border Padding="16" BackgroundColor="{StaticResource DarkSecondaryBackground}">

                <VerticalStackLayout>

                    <Label Text="Insights" Style="{StaticResource SubtitleLabel}" />

                    <CollectionView ItemsSource="{Binding TaskInsights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" TextColor="{StaticResource primarioS}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <CollectionView ItemsSource="{Binding HabitInsights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" TextColor="{StaticResource saveButton}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <CollectionView ItemsSource="{Binding StressInsights}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" TextColor="{StaticResource CancelButton}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </Border>

            <!-- ===================== -->
            <!-- TREND -->
            <!-- ===================== -->

            <VerticalStackLayout BindingContext="{Binding CurrentTrend}">

                <Grid ColumnDefinitions="*,*,*">

                    <Label Text="{Binding StressTrend}"
               TextColor="{StaticResource CancelButton}" />

                    <Label Grid.Column="1"
               Text="{Binding PerformanceTrend}"
               TextColor="{StaticResource primarioS}" />

                    <Label Grid.Column="2"
               Text="{Binding BehaviorTrend}"
               TextColor="{StaticResource saveButton}" />

                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>