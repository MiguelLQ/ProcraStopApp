<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ProcraStop.Modules.StudyTechniques.Presentation.ViewModels"
             xmlns:models="clr-namespace:ProcraStop.Modules.StudyTechniques.Presentation.Models"
             x:Class="ProcraStop.Modules.StudyTechniques.Presentation.Views.AcademicHelpPage"
             x:DataType="viewModels:AcademicHelpViewModel"
             x:Name="PageRoot"
             Title="Ayuda académica"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#0D131C}">
    <ScrollView>
        <VerticalStackLayout Padding="16,20" Spacing="14">
            <Label Text="Pide ayuda a tiempo" FontSize="22" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
            <Label Text="Formula una duda concreta y elige cómo resolverla. Registrar una consulta aquí no envía mensajes a otra persona."
                   FontSize="13" TextColor="{AppThemeBinding Light=#4B5563, Dark=#B8C3D5}" />

            <Border Padding="16" StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#171F2B}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nueva consulta" FontSize="17" FontAttributes="Bold" />
                    <Entry Text="{Binding Topic}" Placeholder="Tema o actividad" />
                    <Editor Text="{Binding Question}" Placeholder="¿Qué no entiendes o qué necesitas verificar?"
                            AutoSize="TextChanges" MinimumHeightRequest="90" />
                    <Picker Title="Vía de apoyo" ItemsSource="{Binding Channels}"
                            ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedChannel}" />
                    <Entry Text="{Binding ContactName}" IsVisible="{Binding NeedsContactName}"
                           Placeholder="Persona o servicio al que consultarás (opcional)" />
                    <Button Text="Preparar consulta" Command="{Binding PlanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    <Label Text="{Binding Feedback}" FontSize="12" TextColor="#2563EB" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Seguimiento" FontSize="17" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Requests}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HelpRequestItem">
                        <Border Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#171F2B}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Topic}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Question}" FontSize="13" />
                                <Label Text="{Binding ChannelText}" FontSize="12" />
                                <Label Text="{Binding StatusText}" FontSize="12" TextColor="#2563EB" />
                                <Label Text="{Binding CreatedText}" FontSize="11" />
                                <Button Text="Ya consulté" IsVisible="{Binding CanMarkRequested}"
                                        Command="{Binding BindingContext.MarkRequestedCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding Id}" />
                                <Button Text="Duda resuelta" IsVisible="{Binding CanResolve}"
                                        Command="{Binding BindingContext.ResolveCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding Id}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
