<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ProcraStop.Modules.Tasks.Presentation.ViewModels"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.CreateTaskPage"
             x:DataType="viewModels:CreateTaskPageViewModel"
             Title="Crear Tarea"
             Shell.TabBarIsVisible="False"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.BackgroundColor="{StaticResource primarioS}"
             x:Name="PageRoot">
    <!-- ROOT -->
    <Grid RowDefinitions="50,*" >

        <!-- ========================= -->
        <!-- HEADER BACKGROUND (AZUL) -->
        <!-- ========================= -->
        <Grid BackgroundColor="{StaticResource primarioS}" />
        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout Spacing="2">
                <!-- ========================= -->
                <!-- CARD PRINCIPAL (FLOAT) -->
                <!-- ========================= -->
                <Border Margin="0,0,0,5"
                        Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        StrokeShape="RoundRectangle 28">
                    <VerticalStackLayout>
                        <!-- HEADER -->
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Crear tarea"
                               FontSize="20"
                               FontFamily="InterSemiBold"
                               TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />

                            <Label Text="Completa la información"
                               FontSize="12"
                               FontFamily="InterRegular"
                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                        </VerticalStackLayout>
                        <!-- Campo: Nombre -->
                        <VerticalStackLayout Spacing="6" Margin="0,5,0,5">
                            <Label Text="Nombre"
                                FontFamily="InterSemiBold"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                            <Border Padding="12,2"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                 StrokeShape="RoundRectangle 10">
                                <Entry Placeholder="Ej. Resolver ejercicios de integrales"
                                    Text="{Binding Title}"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar},  Dark={StaticResource PlaceHolderDarck}}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                    FontFamily="InterRegular"
                                    FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                        <!-- Campo: Descripción -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,5">
                            <Label Text="Descripción"
                               FontFamily="InterSemiBold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            <Border Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                StrokeShape="RoundRectangle 10">
                                <Editor Placeholder="Opcional..."
                                    Text="{Binding Description}"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar}, Dark={StaticResource PlaceHolderDarck}}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                    FontFamily="InterRegular"
                                    FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                        <!-- fecha limite y recordatorio-->
                        <VerticalStackLayout Spacing="6" Margin="0,4,0,8">
                            <Label Text="Tipo de actividad" FontAttributes="Bold" />
                            <Picker ItemsSource="{Binding ActivityTypes}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedActivityOption}" />
                            <Label Text="Primer paso concreto" FontAttributes="Bold" />
                            <Entry Placeholder="Ej. abrir el material y resolver una pregunta"
                                   Text="{Binding FirstStep}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Planificar inicio" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasPlannedStart}" />
                            </Grid>
                            <DatePicker Date="{Binding SelectedPlannedStartDate}"
                                        IsVisible="{Binding HasPlannedStart}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDeliverable}">
                                <Label Text="Planificar revisión antes de entregar" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding HasPlannedReview}" />
                            </Grid>
                            <DatePicker Date="{Binding SelectedPlannedReviewDate}"
                                        IsVisible="{Binding HasPlannedReview}" />
                            <Label Text="Para un examen, agrega los temas abajo; se crearán sesiones de estudio y repaso."
                                   IsVisible="{Binding IsExam}" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2"  Margin="0,0,0,2">
                            <Grid ColumnDefinitions="*,Auto"
                                VerticalOptions="Center">
                                <Label Text="Establecer fecha límite"
                                        FontFamily="InterSemiBold"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                    VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                    IsToggled="{Binding HasDueDate}" />
                            </Grid>

                            <VerticalStackLayout Spacing="2" 
                                IsVisible="{Binding HasDueDate}">
                                <Grid ColumnDefinitions="*,*"
                                    ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Fecha"
                                               FontFamily="InterRegular"
                                              TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                           FontSize="13"
                                           />
                                        <DatePicker Date="{Binding SelectedDueDate}" FontAttributes="Bold" TextColor="{StaticResource primarioO}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Hora"
                                           FontSize="13"
                                                FontFamily="InterRegular"
                                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                            />
                                        <TimePicker Time="{Binding SelectedDueTime}" FontAttributes="Bold" TextColor="{StaticResource primarioO}"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="{Binding DueDatePreviewText}"
                                       FontSize="13"
                                       FontFamily="InterRegular"
                                       Padding="10,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                <!--RECORDATORIO -->
                                <VerticalStackLayout Spacing="1" Margin="0,4,0,0">

                                    <Label Text="Recordatorio"
                                           FontFamily="InterSemiBold"
                                            FontSize="14"
                                            TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                         />
                                    <Picker Title="Selecciona cuándo avisarte"
                                        ItemsSource="{Binding ReminderOffsets}"
                                        SelectedIndex="{Binding SelectedReminderOffsetIndex}" TextColor="{StaticResource primarioO}" />

                                    <!-- Preview del recordatorio -->
                                    <Label Text="{Binding ReminderPreviewText}"
                                       FontSize="13"
                                           Padding="10,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <!--Minutos estimados-->
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,5" HorizontalOptions="Start">
                            <Label Text="Minutos estimados"
                                FontFamily="InterSemiBold"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                            <Border Padding="12,2"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                     StrokeShape="RoundRectangle 10" WidthRequest="160">
                                <Entry Placeholder="Ej. 30"
                                        Text="{Binding EstimatedMinutesText}"
                                        BackgroundColor="Transparent"
                                        Keyboard="Numeric"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar},  Dark={StaticResource PlaceHolderDarck}}"
                                        TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                        FontFamily="InterRegular"
                                        FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                        <!--prioridad-->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Prioridad"
                                FontFamily="InterSemiBold"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            <Picker Title="Selecciona prioridad"
                                ItemsSource="{Binding Priorities}"
                                SelectedItem="{Binding SelectedPriority}" 
                                    TextColor="{StaticResource primarioO}"/>
                        </VerticalStackLayout>
                        <!--curso-->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Curso"
                                FontFamily="InterSemiBold"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            <Picker Title="Selecciona Curso"
                                ItemsSource="{Binding Courses}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCourse}" 
                                TextColor="{StaticResource primarioO}"/>
                        </VerticalStackLayout>
                        <!-- ========================= -->
                        <!-- SUBTAREAS -->
                        <!-- ========================= -->
                        <VerticalStackLayout Spacing="4">

                            <!-- HEADER SUBTAREAS -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,5">
                                <Label Text="Hitos o temas (opcional para tareas)"
                                       FontSize="14"
                                       FontFamily="InterSemiBold"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" 
                                       VerticalOptions="Center"/>

                                <Button Grid.Column="1"
                                        Text="+"
                                        FontSize="17"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        CornerRadius="26"
                                        BackgroundColor="{StaticResource primarioO}"
                                        TextColor="White"
                                        Command="{Binding AddSubtaskCommand}" />
                            </Grid>
                            <!-- INPUT -->
                            <Border Padding="12,2"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                 StrokeShape="RoundRectangle 10">
                                <Entry Placeholder="Ingrese Sub Tarea ..."
                                    Text="{Binding NewSubtaskText}"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar},  Dark={StaticResource PlaceHolderDarck}}"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                    FontFamily="InterRegular"
                                    FontSize="14" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Poner fecha al nuevo hito" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NewSubtaskHasDate}" />
                            </Grid>
                            <DatePicker Date="{Binding NewSubtaskDate}"
                                        IsVisible="{Binding NewSubtaskHasDate}" />

                            <!-- LISTA -->
                            <CollectionView ItemsSource="{Binding Subtasks}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SubtaskModel">

                                        <Border Padding="4"
                                                Margin="0,5"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkBackground}}"
                                                StrokeShape="RoundRectangle 10">

                                            <Grid ColumnDefinitions="*,Auto">

                                                <Label Text="{Binding PlanText}"
                                                       Margin="10,0,0,0"
                                                       VerticalOptions="Center"
                                                       FontFamily="InterRegular"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" 
                                                       />

                                                <!-- BOTÓN X (VISIBLE AHORA) -->
                                                <Button Grid.Column="1"
                                                        Text="✕"
                                                        FontSize="14"
                                                        WidthRequest="22"
                                                        HeightRequest="22"
                                                        BackgroundColor="#EF4444"
                                                        TextColor="White"
                                                        CornerRadius="8"
                                                        Command="{Binding BindingContext.RemoveSubtaskCommand, Source={x:Reference PageRoot}}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                       
                        <Button Text="Guardar actividad"
                            Command="{Binding SaveCommand}"
                            HeightRequest="50"
                            TextColor="White"
                            IsEnabled="{Binding CanSave}" />
                        <Label Text="{Binding ValidationMessage}" TextColor="#DC2626" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                            IsVisible="{Binding IsSaving}" />

                    </VerticalStackLayout>
                    
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    
</ContentPage>
