<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskDetailPage"
             Title="TaskDetailPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- HEADER CARD -->
            <Border Padding="16"
                    StrokeThickness="1"
                    
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Padding="20" Spacing="14">

                    <!-- TITLE -->
                    <Label Text="{Binding Task.Title}"
           FontSize="26"
           FontAttributes="Bold"
           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

                    <!-- DESCRIPTION -->
                    <Label Text="{Binding Task.Description}"
           FontSize="14"
           TextColor="{StaticResource Gray500}"
           LineBreakMode="WordWrap" />

                    <!-- DIVIDER -->
                    <BoxView HeightRequest="1"
             Color="{StaticResource Gray100}"
             Opacity="0.5"/>

                    <!-- META LIST (clean rows style) -->
                    <VerticalStackLayout Spacing="10">

                        <!-- DUE DATE -->
                        <Grid ColumnDefinitions="140,*">
                            <Label Text="📅 Vence"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"/>

                            <Label Grid.Column="1"
                   Text="{Binding Task.DueDateText}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"/>
                        </Grid>

                        <!-- PRIORITY -->
                        <Grid ColumnDefinitions="140,*">
                            <Label Text="⚡ Prioridad"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"/>

                            <Label Grid.Column="1"
                   Text="{Binding Task.PriorityText}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"/>
                        </Grid>

                        <!-- STATUS -->
                        <Grid ColumnDefinitions="140,*">
                            <Label Text="📌 Estado"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"/>

                            <Label Grid.Column="1"
                   Text="{Binding Task.StatusText}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"/>
                        </Grid>

                        <!-- COURSE -->
                        <Grid ColumnDefinitions="140,*"
              IsVisible="{Binding Task.HasCourse}">
                            <Label Text="🎓 Curso"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"/>

                            <Label Grid.Column="1"
                   Text="{Binding Task.CourseName}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"/>
                        </Grid>

                        <!-- REMINDER (si lo tienes en model) -->
                        <Grid ColumnDefinitions="140,*">
                            <Label Text="⏰ Recordatorio"
                   TextColor="{StaticResource Gray500}"
                   FontSize="13"/>

                            <Label Grid.Column="1"
                   Text="{Binding Task.ReminderText}"
                   FontAttributes="Bold"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"/>
                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- SUBTASK HEADER -->
            <Label Text="Subtareas"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

            <!-- SUBTASK LIST -->
            <CollectionView ItemsSource="{Binding Task.Subtasks}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="12"
                                Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                Stroke="{StaticResource Gray100}"
                                StrokeShape="RoundRectangle 14">

                            <Grid ColumnDefinitions="Auto,*"
                                  VerticalOptions="Center">

                                <!-- CHECKBOX -->
                                <CheckBox IsChecked="{Binding IsCompleted}" />

                                <!-- TITLE -->
                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>