<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskDetailPage"
             xmlns:components="clr-namespace:ProcraStop.Shared.UI.Components"
             xmlns:base="clr-namespace:ProcraStop.Shared.UI.Layouts"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             xmlns:viewModels="clr-namespace:ProcraStop.Modules.Tasks.Presentation.ViewModels"
             x:DataType="viewModels:TaskDetailViewModel"
             Shell.BackgroundColor="{StaticResource cabecera}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
             Shell.TabBarIsVisible="False"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Title="Detalle de Tarea">

    <!-- ROOT -->
    <Grid x:Name="PageRoot" RowDefinitions="85,*,Auto">

        <!-- ========================= -->
        <!-- HEADER BACKGROUND -->
        <!-- ========================= -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource primarioS}" />

        <!-- ========================= -->
        <!-- CONTENT (SUPERPUESTO) -->
        <!-- ========================= -->
        <ScrollView Grid.Row="0"
                    Grid.RowSpan="2">

            <VerticalStackLayout Spacing="10">

                <!-- ESPACIO PARA BAJAR EL CARD -->
                <BoxView HeightRequest="1" Opacity="0"/>

                <!-- ========================= -->
                <!-- CARD PRINCIPAL -->
                <!-- ========================= -->
                <Border Margin="8,0,8,0"
                        Padding="5"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                        StrokeShape="RoundRectangle 30">

                    <VerticalStackLayout Padding="18" Spacing="12">

                        <!-- HEADER -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label Text="{Binding CurrentTask.Title}"
                                       FontSize="18"
                                       FontFamily="SegoeSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />

                                <Label Text="{Binding CurrentTask.Description}"
                                       FontSize="14"
                                       FontFamily="ManropeRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                       LineBreakMode="WordWrap" />

                            </VerticalStackLayout>
                            

                            <!-- PRIORITY -->
                            <Border Grid.Column="1"
                                    Padding="10,5"
                                    BackgroundColor="{Binding CurrentTask.PriorityColorHex}"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start">

                                <Label Text="{Binding CurrentTask.PriorityText}"
                                       FontSize="11"
                                       TextColor="#d9e2ff"
                                       FontFamily="MontserratRegular" />
                            </Border>

                        </Grid>

                        <!-- DIVIDER -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                  />
              
                        <!-- META -->
                        <VerticalStackLayout Spacing="15">

                            <!-- DUE DATE -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label Text="📅" FontSize="14" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Fecha de vencimiento"
                                           FontSize="14"
                                           FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                    <Label Text="{Binding CurrentTask.DueDateText}"
                                           FontSize="14"
                                           FontFamily="InterSemiBold"
                                           TextColor="{Binding CurrentTask.DueDateColorHex}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- STATUS -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label Text="📌" FontSize="14" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Estado"
                                           FontFamily="OpenSansRegular"
                                           FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                    <Label Text="{Binding CurrentTask.StatusText}"
                                           FontSize="14"
                                           FontFamily="InterSemiBold"
                                           TextColor="{Binding CurrentTask.StatusColorHex}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- REMINDER -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label Text="⏰" FontSize="14" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Recordatorio"
                                           FontSize="14"
                                           FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                    <Label Text="{Binding CurrentTask.ReminderText}"
                                           FontSize="14"
                                           FontFamily="InterSemiBold" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- COURSE -->
                            <Border IsVisible="{Binding CurrentTask.HasCourse}"
                                    HeightRequest="40"
                                    Padding="0"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                <HorizontalStackLayout Spacing="15">
                                    <BoxView WidthRequest="12"
                                             HeightRequest="40"
                                             CornerRadius="8"
                                             Background="Transparent"
                                             Color="{Binding CurrentTask.CourseColor}" />
                                    <Label Text="curso:"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                          FontFamily="OpenSansRegular"
                                          TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"

                                  >
                                        
                                    </Label>
                                    <Label Text="{Binding CurrentTask.CourseName}"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           FontFamily="OpenSansRegular"
                                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                </HorizontalStackLayout>
                            </Border>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Border Margin="15,0" Padding="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding CurrentTask.ActivityTypeText}" FontAttributes="Bold" />
                        <Label Text="{Binding CurrentTask.AcademicPlanText}" FontSize="13" />
                        <Label Text="{Binding CurrentTask.FirstStep}" FontSize="13" />
                        <Button Text="Empezar ahora" Command="{Binding StartTaskCommand}"
                                IsVisible="{Binding CurrentTask.CanStart}" />
                        <Button Text="Practicar con técnicas de estudio"
                                Command="{Binding PracticeExamCommand}"
                                IsVisible="{Binding CurrentTask.IsExam}" />
                        <Button Text="Necesito ayuda con esta actividad"
                                Command="{Binding GoToHelpCommand}" />
                        <VerticalStackLayout IsVisible="{Binding CurrentTask.IsDeliverable}" Spacing="5">
                            <Label Text="{Binding CurrentTask.ReviewText}" FontSize="13" />
                            <VerticalStackLayout IsVisible="{Binding CurrentTask.CanReview}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox IsChecked="{Binding ReviewContentChecked}" />
                                    <Label Grid.Column="1" Text="Contenido y criterios completos"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox IsChecked="{Binding ReviewFormatChecked}" />
                                    <Label Grid.Column="1" Text="Formato, citas y archivo revisados"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Button Text="Confirmar revisión" Command="{Binding ReviewTaskCommand}"
                                        IsEnabled="{Binding CanConfirmReview}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SUBTASKS -->
                <Label Text="{Binding CurrentTask.SubtasksSectionTitle}"
                       Margin="15,10,15,0"
                       FontSize="15"
                       FontFamily="MontserratSemiBold"
                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
               
                <ProgressBar Progress="{Binding CurrentTask.Progress}"
                    HeightRequest="6"
                    Margin="25,5,25,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkBackground}}"
                    ProgressColor="{Binding CurrentTask.ProgressColorHex}"/>
                <Label Text="{Binding CurrentTask.ProgressText}"
                    FontSize="12"
                    Margin="25,0,15,0"
                    FontFamily="OpenSansRegular"
                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                <CollectionView ItemsSource="{Binding CurrentTask.Subtasks}"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SubtaskModel">
                            <Border Padding="8"
                                    Margin="15,0,15,8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                                    StrokeShape="RoundRectangle 14">

                                <Grid ColumnDefinitions="Auto,*"
                                      VerticalOptions="Center">

                                    <CheckBox IsChecked="{Binding IsCompleted}"
                                          Command="{Binding Path=BindingContext.ToggleSubtaskCommand, Source={x:Reference PageRoot}}"
                                          CommandParameter="{Binding .}" />

                                    <Label Grid.Column="1"
                                           Text="{Binding PlanText}"
                                           FontSize="14"
                                           FontFamily="OpenSansRegular"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- espacio para que no tape botones -->
                <BoxView  Opacity="0"/>

            </VerticalStackLayout>

        </ScrollView>

        <!-- ========================= -->
        <!-- ACTIONS (FIJO) -->
        <!-- ========================= -->
        <Border Grid.Row="2"
                VerticalOptions="Center"
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="7">

                <Button 
                        Text="{Binding CurrentTask.CompleteButtonText}"
                        BackgroundColor="{Binding CurrentTask.CompleteButtonColor}"
                        IsEnabled="{Binding CurrentTask.CanComplete}"
                        Command="{Binding CompleteTaskCommand}" 
                        TextColor="#d9e2ff"
                        CornerRadius="12"
                        WidthRequest="160"
                        FontSize="16"
                        FontFamily="InterSemiBold" />

                <Button Grid.Column="1"
                        Text="Editar >"
                        WidthRequest="120"
                          IsVisible="{Binding CanEdit}"
                        Command="{Binding GoToEditCommand}" 
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource DarkOnLightBackground}"
                        CornerRadius="11"
                        FontSize="16"
                        FontFamily="InterSemiBold" 
                     />

                <Button Grid.Column="2"
                        Text="🗑"
                        Command="{Binding DeleteTaskCommand}"
                        FontSize="15"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="12" />

            </Grid>

        </Border>

        <!-- El snackbar vive en el XAML para no reparentar el contenido de la
             página (ver TasksPage.xaml). -->
        <components:CustomSnackbar x:Name="SnackbarHost"
                                   Grid.Row="1"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="End"
                                   Margin="0,0,0,40"
                                   ZIndex="99" />

    </Grid>

</base:BasePage>
