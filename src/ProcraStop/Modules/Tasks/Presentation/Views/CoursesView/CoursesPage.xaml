<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.CoursesView.CoursesPage"
             x:Name="PageRoot"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkSecondaryBackground}}">

    <Grid RowDefinitions="Auto,*">

        <!-- ========================= -->
        <!-- FORM --> 
        <!-- ========================= -->

        <Border Grid.Row="0"
            Margin="15,5,15,5"
            Padding="14"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkBackground}}"
            StrokeShape="RoundRectangle 14">

            <VerticalStackLayout Spacing="0">
                <!-- HEADER del card -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Nuevo curso"
                               FontFamily="InterSemiBold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                        <Label Text="Completa los campos para agregar"
                               FontFamily="InterRegular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                    </VerticalStackLayout>

                    <!-- Botón Limpiar arriba a la derecha -->
                    <Border Grid.Column="1"
                            Padding="10,6"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Limpiar"
                               FontFamily="InterRegular"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    </Border>
                </Grid>
                <!-- Separador -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}"
                         Margin="0,0,0,6" />
                <!-- Campo: Nombre -->
                <VerticalStackLayout Spacing="6" Margin="0,0,0,5">
                    <Label Text="Nombre"
                           FontFamily="InterSemiBold"
                           FontSize="12"
                           CharacterSpacing="0.5"
                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                    <Border Padding="12,5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                            StrokeShape="RoundRectangle 10">
                        <Entry Placeholder="Ej: Matemáticas"
                               Text="{Binding Name}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar},  Dark={StaticResource PlaceHolderDarck}}"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                               FontFamily="InterRegular"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Campo: Descripción -->
                <VerticalStackLayout Spacing="6" Margin="0,0,0,8">
                    <Label Text="Descripción"
                           FontFamily="InterSemiBold"
                           FontSize="12"
                           CharacterSpacing="0.5"
                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                    <Border Padding="12,5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                            StrokeShape="RoundRectangle 10">
                        <Editor Placeholder="Opcional..."
                                Text="{Binding Description}"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource PlaceHolderClar}, Dark={StaticResource PlaceHolderDarck}}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                FontFamily="InterRegular"
                                FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- TU SELECTOR (NO TOCADO) -->
                <Label Text="Selecciona un color de etiqueta"
                       FontFamily="InterSemiBold"
                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                         FontSize="12"/>

                <Label Text="{Binding SelectedColor}"
                     FontSize="12"/>

                <CollectionView ItemsSource="{Binding ColorOptions}"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4">

                                <BoxView WidthRequest="32"
                                 HeightRequest="32"
                                 CornerRadius="16"
                                 Background="Transparent"
                                 Color="{Binding Hex}" />

                                <Border Stroke="Blue"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 20"
                                IsVisible="{Binding IsSelected}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectColorCommand}"
                                CommandParameter="{Binding}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView HeightRequest="1"
                      Color="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}"
                      Margin="0,10,0,10" />
                <!-- BOTONES -->
                <Grid ColumnDefinitions="*"
              ColumnSpacing="10">

                    <Button Text="Guardar"
                    HeightRequest="40"
                    FontSize="13"
                    BackgroundColor="{StaticResource primarioO}"
                    TextColor="White"
                    CornerRadius="10"
                    Command="{Binding SaveCommand}" />

                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- ========================= -->
        <!-- LISTA -->
        <!-- ========================= -->

        <CollectionView Grid.Row="1"
                        Margin="16,0,16,16"
                        ItemsSource="{Binding Courses}"
                        SelectionMode="Single"
                        BackgroundColor="Transparent"
                        SelectedItem="{Binding SelectedCourse}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Margin="0,3"
                            Padding="7"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkBackground}}"
                            StrokeShape="RoundRectangle 12" >
                        

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">

                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{StaticResource Gray300}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="6,*,Auto"
                              ColumnSpacing="12">

                            <!-- COLOR STRIP -->
                            <BoxView Color="{Binding Color}" 
                                     WidthRequest="10"
                                     HeightRequest="40"
                                     CornerRadius="5"
                                     Background="Transparent"/>

                            <!-- TEXTO -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2">

                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation" />

                            </VerticalStackLayout>

                            <!-- BOTONES -->
                            <HorizontalStackLayout Grid.Column="2"
                                                   Spacing="6"
                                                   VerticalOptions="Center"
                                                   >

                                <Button Text="Editar"
                                    FontSize="12"
                                    HeightRequest="2"
                                    Command="{Binding BindingContext.EditCommand, 
                                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}" />

                                <Button Text="Eliminar"
                                    FontSize="12"
                                    HeightRequest="2"
                                    BackgroundColor="#EF4444"
                                    TextColor="White"
                                    Command="{Binding BindingContext.DeleteCommand, 
                                              Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}" />

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>