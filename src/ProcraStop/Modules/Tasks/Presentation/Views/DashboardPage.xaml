<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.DashboardPage"
             Title="DashboardPage">
    <VerticalStackLayout Padding="16" Spacing="16">

        <!-- GUIDANCE -->
        <Frame Padding="12" Margin="0,0,0,10">
            <Label 
            Text="{Binding GuidanceMessage}"
            FontAttributes="Bold" />
        </Frame>

        <!-- TODAY -->
        <Label 
        Text="Hoy deberías enfocarte en:"
        FontSize="20"
        FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding TodayTasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,4">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding EstimatedMinutes, StringFormat='Tiempo: {0} min'}" />
                            <Label Text="{Binding Effort}" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 🔥 FOCUS MODE (NUEVO) -->
        <Label 
        Text="🔥 Focus Mode"
        FontSize="20"
        FontAttributes="Bold" />

        <Label 
        Text="Haz esto ahora mismo:"
        FontSize="14"
        TextColor="Gray"/>

        <CollectionView ItemsSource="{Binding FocusTasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Padding="14" Margin="0,5" >

                        <VerticalStackLayout Spacing="4">

                            <Label 
                            Text="{Binding Title}"
                            FontAttributes="Bold"
                            FontSize="16"/>

                            <Label 
                            Text="{Binding Effort}"
                            TextColor="Red"
                            FontAttributes="Bold"/>

                            <Label 
                            Text="{Binding EstimatedMinutes, StringFormat='Duración: {0} min'}"
                            FontSize="12"
                            TextColor="Gray"/>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>