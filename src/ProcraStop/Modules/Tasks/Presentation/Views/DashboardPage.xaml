<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.DashboardPage"
             Title="DashboardPage">
    <VerticalStackLayout Padding="16" Spacing="16">

        <Border Padding="16">
            <VerticalStackLayout Spacing="8">

                <Label 
                Text="{Binding Message}"
                FontSize="18"
                FontAttributes="Bold" />

                <Label 
                Text="{Binding SuggestedAction}"
                FontSize="14"
                TextColor="Gray" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentPage>