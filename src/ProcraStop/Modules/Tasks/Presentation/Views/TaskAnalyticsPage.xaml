<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskAnalyticsPage"
             Shell.BackgroundColor="{StaticResource DarkSecondaryBackground}"
             Title="TaskAnalyticsPage">
    
    <ScrollView>
        
        <VerticalStackLayout Padding="0" Spacing="20">
            <Grid RowDefinitions="Auto,*">

                <!-- CONTENT -->
                <Grid Grid.Row="1"
                      Background="{StaticResource DarkSecondaryBackground}"
                      RowDefinitions="Auto,*"
                      Padding="0,0,0,-20">

                    <!-- CARD GRANDE -->
                    <Border
                        BackgroundColor="{StaticResource DarkSecondaryBackground}"
                        StrokeShape="RoundRectangle 40"
                        HeightRequest="300"
                        Padding="0,20,0,20"
                        Margin="0,0,0,-30">

                        <Grid RowDefinitions="Auto,*"
                          RowSpacing="16"
                          Padding="20,0">

                            <!-- HEADER -->
                            <Grid ColumnDefinitions="*,Auto,Auto"
          VerticalOptions="Start">

                                <Label Text="Average power usage"
               FontSize="16"
               TextColor="#D1D5DB"
               VerticalOptions="Center"/>

                                <Border Grid.Column="1"
                Margin="10,0,0,0"
                Stroke="#2563EB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="10"
                HeightRequest="40"
                WidthRequest="40">

                                    <Label Text="≡"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="#3B82F6"/>
                                </Border>

                                <Border Grid.Column="2"
                Margin="8,0,0,0"
                Stroke="#374151"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="10"
                HeightRequest="40"
                WidthRequest="40">

                                    <Label Text="▤"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="#9CA3AF"/>
                                </Border>

                            </Grid>


                            <!-- CONTENIDO FLEXIBLE -->
                            <Grid Grid.Row="1"
          VerticalOptions="Fill">

                                <!-- CARD INTERNO -->
                                <Border
            BackgroundColor="#1F2937"
            StrokeShape="RoundRectangle 20"
            Padding="16"
            Margin="0,10,0,0"
            VerticalOptions="Start">

                                    <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">

                                        <Border
                    BackgroundColor="#1E3A8A"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="48"
                    HeightRequest="48"
                    VerticalOptions="Center">

                                            <Label Text="⚡"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="#60A5FA"
                           FontSize="20"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center">

                                            <Label Text="Usage overview"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="White"/>

                                            <Label Text="Your consumption is higher than last week."
                           FontSize="12"
                           TextColor="#9CA3AF"/>

                                        </VerticalStackLayout>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Grid>
                    </Border>

                </Grid>

            </Grid>
            <!-- HEADER -->
            <VerticalStackLayout Spacing="4" Padding="20,30,20,0">
                <Label Text="Task Analytics"
                       FontSize="28"
                       FontFamily="InterSemiBold"/>

                <Label Text="Resumen de tu carga actual"
                       FontSize="14"
                       Opacity="0.6"/>
            </VerticalStackLayout>

            <!-- GRID DE MÉTRICAS -->
            <Grid ColumnDefinitions="*,*"
                  Padding="20"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <!-- TOTAL -->
                <Border Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Total"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Total}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- COMPLETADAS -->
                <Border Grid.Row="0" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1E2E1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Completadas"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Completed}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PENDIENTES -->
                <Border Grid.Row="1" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#2E2A1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Pendientes"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Pending}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- OVERDUE -->
                <Border Grid.Row="1" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#2E1E1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Atrasadas"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Overdue}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PRIORIDAD ALTA -->
                <Border Grid.Row="2" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#2E1E2A"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Alta prioridad"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding HighPriority}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PRIORIDAD MEDIA -->
                <Border Grid.Row="2" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1E2A2E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Media prioridad"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding MediumPriority}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>