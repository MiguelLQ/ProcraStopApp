<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Controls"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskAnalyticsPage"
             Title="Análisis de tareas"
             Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}"
             Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#0D131C}">

    <!-- editbycodex: dashboard funcional inspirado en Stress, con series de tareas optimizadas. -->
    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="0,0,0,28">

                <!-- HEADER ANALÍTICO -->
                <Border BackgroundColor="{AppThemeBinding Light=#172231, Dark=#101923}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,28,28"
                        Padding="18,16,18,18">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ritmo de finalización"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="20"
                                       TextColor="White" />
                                <Label Text="Tareas completadas durante los últimos 7 días"
                                       FontFamily="OpenSansRegular"
                                       FontSize="12"
                                       TextColor="#A8B4C5" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="#203A32"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding PerformanceText}"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="11"
                                       TextColor="#5DDB9A" />
                            </Border>
                        </Grid>

                        <controls:TaskAnalyticsChart ChartType="Line"
                                                     Values="{Binding WeeklyValues}"
                                                     Labels="{Binding WeeklyLabels}"
                                                     HeightRequest="220" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="COMPLETADAS ESTA SEMANA"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding CompletedThisWeek}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="White" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="PRÓXIMOS 7 DÍAS"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding DueNextSevenDays}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#F4B740" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Padding="14,0" Spacing="18">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TOTAL" Style="{StaticResource AnalyticsCaptionStyle}" />
                                <Label Text="{Binding Total}" Style="{StaticResource AnalyticsValueStyle}" />
                                <Label Text="tareas activas y completadas" Style="{StaticResource AnalyticsDetailStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource AnalyticsCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="CUMPLIMIENTO" Style="{StaticResource AnalyticsCaptionStyle}" />
                                <Label Text="{Binding CompletionRateText}" Style="{StaticResource AnalyticsValueStyle}" TextColor="#34C77B" />
                                <Label Text="progreso general" Style="{StaticResource AnalyticsDetailStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AnalyticsCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="VENCIDAS" Style="{StaticResource AnalyticsCaptionStyle}" />
                                <Label Text="{Binding Overdue}" Style="{StaticResource AnalyticsValueStyle}" TextColor="#EF5B5B" />
                                <Label Text="requieren atención" Style="{StaticResource AnalyticsDetailStyle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AnalyticsCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="ESFUERZO PROM." Style="{StaticResource AnalyticsCaptionStyle}" />
                                <Label Text="{Binding AverageEffortText}" Style="{StaticResource AnalyticsValueStyle}" TextColor="#4F8CFF" />
                                <Label Text="estimación por tarea" Style="{StaticResource AnalyticsDetailStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource AnalyticsCardStyle}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Distribución por estado" Style="{StaticResource AnalyticsSectionTitleStyle}" />
                            <Label Text="Vista general de tu flujo actual" Style="{StaticResource AnalyticsDetailStyle}" />
                            <controls:TaskAnalyticsChart ChartType="Donut"
                                                         Values="{Binding StatusValues}"
                                                         Labels="{Binding StatusLabels}"
                                                         HeightRequest="210" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AnalyticsCardStyle}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Carga por prioridad" Style="{StaticResource AnalyticsSectionTitleStyle}" />
                            <Label Text="Dónde conviene enfocar tu siguiente bloque" Style="{StaticResource AnalyticsDetailStyle}" />
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding PriorityValues}"
                                                         Labels="{Binding PriorityLabels}"
                                                         HeightRequest="190" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AnalyticsCardStyle}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Tareas por curso" Style="{StaticResource AnalyticsSectionTitleStyle}" />
                            <Label Text="Los cinco grupos con mayor carga" Style="{StaticResource AnalyticsDetailStyle}" />
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding CourseValues}"
                                                         Labels="{Binding CourseLabels}"
                                                         HeightRequest="260" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

    <ContentPage.Resources>
        <!-- editbycodex: estilos locales para no alterar otras páginas del proyecto. -->
        <Style x:Key="AnalyticsCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#171F2B}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6EAF0, Dark=#263246}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="AnalyticsCaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="MontserratSemiBold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#91A0B6}" />
        </Style>
        <Style x:Key="AnalyticsValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="MontserratSemiBold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F4F7FB}" />
        </Style>
        <Style x:Key="AnalyticsDetailStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#91A0B6}" />
        </Style>
        <Style x:Key="AnalyticsSectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="MontserratSemiBold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F4F7FB}" />
        </Style>
    </ContentPage.Resources>
</ContentPage>
