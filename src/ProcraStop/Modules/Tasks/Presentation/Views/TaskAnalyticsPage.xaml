<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Controls"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             xmlns:viewModels="clr-namespace:ProcraStop.Modules.Tasks.Presentation.ViewModels"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskAnalyticsPage"
             x:DataType="viewModels:TaskAnalyticsViewModel"
             Title="Análisis de tareas"
             Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}"
             Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <!-- editbycodex: dashboard funcional inspirado en Stress, con series de tareas optimizadas. -->
    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Spacing="10" Padding="0,0,0,20">

                <!-- HEADER ANALÍTICO -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,45,45"
                        Padding="15,0,15,15">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">

                                <Label Text="Tareas completadas durante los últimos 7 días"
                                       FontFamily="OpenSansRegular"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="#203A32"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding PerformanceText}"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="11"
                                       TextColor="#5DDB9A" />
                            </Border>
                        </Grid>

                        <controls:TaskAnalyticsChart ChartType="Line"
                                                     Values="{Binding WeeklyValues}"
                                                     Labels="{Binding WeeklyLabels}"
                                                     HeightRequest="210" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                <Label Text="COMPLETADAS ESTA SEMANA"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding CompletedThisWeek}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       HorizontalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                <Label Text="PRÓXIMOS 7 DÍAS"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding DueNextSevenDays}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       HorizontalOptions="Center"
                                       TextColor="#F4B740" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <!--pastel-->
                <Border Padding="15,0,15,-20" >
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Distribución por estado" 
                               FontFamily="MontserratSemiBold"
                               FontSize="18"/>
                        <Label Text="Vista general de tu flujo actual" 
                               FontSize="14"
                               FontFamily="OpenSansRegular"
                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                        <controls:TaskAnalyticsChart ChartType="Donut"
                                     Values="{Binding StatusValues}"
                                     Labels="{Binding StatusLabels}"
                                     HeightRequest="230" />
                    </VerticalStackLayout>
                </Border>
                <!--cards-->
                <VerticalStackLayout Padding="14,0" Spacing="18">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}" >
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Total"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="17"/>
                                <Label Text="{Binding Total}"/>
                                <Label Text="tareas activas y completadas" FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Cumplimiento"
                                       FontFamily="MontserratSemiBold"
                                        FontSize="17"/>
                                <Label Text="{Binding CompletionRateText}"  TextColor="#34C77B" />
                                <Label Text="progreso general" FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Vencidas"
                                       FontFamily="MontserratSemiBold"
                                        FontSize="17"/>
                                <Label Text="{Binding Overdue}"  TextColor="#EF5B5B" />
                                <Label Text="requieren atención" FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}" >
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Esfuerzo Prom." FontFamily="MontserratSemiBold"
                                       FontSize="17"/>
                                <Label Text="{Binding AverageEffortText}"  TextColor="#4F8CFF" />
                                <Label Text="estimación por tarea" FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- D1 EPA: postergación al último momento -->
                    <Border Padding="15,0,15,0">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Postergación (EPA D1)" FontFamily="MontserratSemiBold"
                                   FontSize="17" />
                            <Label Text="Cuándo empiezas realmente tus tareas, no solo cuándo las terminas"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                            <Border IsVisible="{Binding HasOverdueStarts}"
                                    BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3A2E12}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,9">
                                <Label Text="{Binding OverdueStartNotStarted, StringFormat='{0} tarea(s) debían empezar y siguen sin iniciar'}"
                                       FontFamily="ManropeSemiBold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                            </Border>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="10">
                                <Border Grid.Row="0" Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Primer avance"
                                               FontFamily="MontserratSemiBold"
                                               FontSize="17" />
                                        <Label Text="{Binding FirstProgressAverageText}" TextColor="#4F8CFF" />
                                        <Label Text="desde que creaste la tarea" FontFamily="OpenSansRegular"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Retraso al iniciar"
                                               FontFamily="MontserratSemiBold"
                                               FontSize="17" />
                                        <Label Text="{Binding StartDelayAverageText}" TextColor="#F4B740" />
                                        <Label Text="frente al inicio previsto" FontFamily="OpenSansRegular"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Inicio puntual"
                                               FontFamily="MontserratSemiBold"
                                               FontSize="17" />
                                        <Label Text="{Binding OnTimeStartRateText}" TextColor="#34C77B" />
                                        <Label Text="empezaron a tiempo" FontFamily="OpenSansRegular"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Inicio al límite"
                                               FontFamily="MontserratSemiBold"
                                               FontSize="17" />
                                        <Label Text="{Binding LastMinuteStartRateText}" TextColor="#EF5B5B" />
                                        <Label Text="en las últimas 24 h" FontFamily="OpenSansRegular"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Label IsVisible="{Binding HasStartMetrics}"
                                   Text="{Binding MeasuredStarts, StringFormat='Basado en {0} tarea(s) con inicio medido.'}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- D1 EPA: postergación por curso -->
                    <Border Padding="15,0,15,0" IsVisible="{Binding HasCourseMetrics}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Postergación por curso" FontFamily="MontserratSemiBold"
                                   FontSize="17" />
                            <Label Text="Cómo inicias las tareas de cada curso. La valoración es opcional y no reemplaza a la conducta."
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding CourseMetrics}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CourseMetricItemModel">
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12,10">
                                            <VerticalStackLayout Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding CourseName}"
                                                           FontFamily="MontserratSemiBold"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding ShowAvoidance}"
                                                            BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3A2E12}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="8,3"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding AvoidanceText}"
                                                               FontFamily="ManropeSemiBold"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{Binding AppraisalText}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                                <Label Text="{Binding VolumeText}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                                <Label Text="{Binding DelayText}"
                                                       IsVisible="{Binding ShowMetrics}"
                                                       FontSize="12"
                                                       FontFamily="ManropeSemiBold"
                                                       TextColor="#F4B740" />
                                                <HorizontalStackLayout Spacing="12" IsVisible="{Binding ShowMetrics}">
                                                    <Label Text="{Binding OnTimeText}"
                                                           FontSize="11"
                                                           TextColor="#34C77B" />
                                                    <Label Text="{Binding LastMinuteText}"
                                                           FontSize="11"
                                                           TextColor="#EF5B5B" />
                                                </HorizontalStackLayout>
                                                <Label Text="Sin datos suficientes (mín. 3 inicios medidos)."
                                                       IsVisible="{Binding ShowInsufficientData}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- D1 EPA: lecturas por curso -->
                    <Border Padding="15,0,15,0" IsVisible="{Binding HasReadingMetrics}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Lecturas por curso" FontFamily="MontserratSemiBold"
                                   FontSize="17" />
                            <Label Text="El primer capítulo o sección completado cuenta como primer avance de la lectura."
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding ReadingMetrics}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CourseMetricItemModel">
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12,10">
                                            <VerticalStackLayout Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label Text="{Binding CourseName}"
                                                           FontFamily="MontserratSemiBold"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding ShowAvoidance}"
                                                            BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3A2E12}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="8,3"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding AvoidanceText}"
                                                               FontFamily="ManropeSemiBold"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                                                    </Border>
                                                </Grid>
                                                <Label Text="{Binding AppraisalText}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                                <Label Text="{Binding VolumeText}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                                <Label Text="{Binding DelayText}"
                                                       IsVisible="{Binding ShowMetrics}"
                                                       FontSize="12"
                                                       FontFamily="ManropeSemiBold"
                                                       TextColor="#F4B740" />
                                                <HorizontalStackLayout Spacing="12" IsVisible="{Binding ShowMetrics}">
                                                    <Label Text="{Binding OnTimeText}"
                                                           FontSize="11"
                                                           TextColor="#34C77B" />
                                                    <Label Text="{Binding LastMinuteText}"
                                                           FontSize="11"
                                                           TextColor="#EF5B5B" />
                                                </HorizontalStackLayout>
                                                <Label Text="Sin datos suficientes (mín. 3 inicios medidos)."
                                                       IsVisible="{Binding ShowInsufficientData}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!--indicadores-->
                    <Border  Padding="15,0,15,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Carga por prioridad" FontFamily="MontserratSemiBold"
                                       FontSize="17"/>
                            <Label Text="Dónde conviene enfocar tu siguiente bloque" FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding PriorityValues}"
                                                         Labels="{Binding PriorityLabels}"
                                                         HeightRequest="190" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="15,0,15,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Tareas por curso"  FontFamily="MontserratSemiBold"
                                       FontSize="17"/>
                            <Label Text="Los cinco grupos con mayor carga" FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding CourseValues}"
                                                         Labels="{Binding CourseLabels}"
                                                         HeightRequest="250" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
