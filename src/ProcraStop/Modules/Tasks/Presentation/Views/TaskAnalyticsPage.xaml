<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TaskAnalyticsPage"
             Title="TaskAnalyticsPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- HEADER -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Task Analytics"
                       FontSize="28"
                       FontFamily="InterSemiBold"/>

                <Label Text="Resumen de tu carga actual"
                       FontSize="14"
                       Opacity="0.6"/>
            </VerticalStackLayout>

            <!-- GRID DE MÉTRICAS -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <!-- TOTAL -->
                <Border Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#1E1E2E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Total"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Total}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- COMPLETADAS -->
                <Border Grid.Row="0" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1E2E1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Completadas"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Completed}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PENDIENTES -->
                <Border Grid.Row="1" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#2E2A1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Pendientes"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Pending}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- OVERDUE -->
                <Border Grid.Row="1" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#2E1E1E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Atrasadas"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding Overdue}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PRIORIDAD ALTA -->
                <Border Grid.Row="2" Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="#2E1E2A"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Alta prioridad"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding HighPriority}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PRIORIDAD MEDIA -->
                <Border Grid.Row="2" Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="#1E2A2E"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <VerticalStackLayout>
                        <Label Text="Media prioridad"
                               FontSize="12"
                               Opacity="0.6"/>
                        <Label Text="{Binding MediumPriority}"
                               FontSize="24"
                               FontFamily="InterSemiBold"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>