<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.ListTasks"
             >

    <ContentPage.Resources>

            <!-- Colors -->
            <Color x:Key="PageBackground">#F7F9FE</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="PrimaryColor">#2F6BFF</Color>
            <Color x:Key="PrimaryLightColor">#EEF4FF</Color>
            <Color x:Key="TitleColor">#111827</Color>
            <Color x:Key="SubtitleColor">#667085</Color>
            <Color x:Key="MutedColor">#98A2B3</Color>
            <Color x:Key="DividerColor">#E8EDF6</Color>
            <Color x:Key="DangerColor">#F04438</Color>
            <Color x:Key="WarningColor">#F59E0B</Color>
            <Color x:Key="PurpleColor">#7C3AED</Color>
            <Color x:Key="OrangeLightColor">#FFF4E5</Color>
            <Color x:Key="PurpleLightColor">#F2EAFE</Color>

            <!-- Text Styles -->
            <Style x:Key="PageTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="TextColor" Value="{StaticResource TitleColor}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource TitleColor}" />
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>

            <Style x:Key="TaskTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterSemiBold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource TitleColor}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="TaskMetaStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SubtitleColor}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SmallLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="InterRegular" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource SubtitleColor}" />
            </Style>

            <!-- Reusable Border Styles -->
            <Style x:Key="SoftCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#D9E2F2"
                            Offset="0,8"
                            Radius="18"
                            Opacity="0.30" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="#E3E9F4" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="Stroke" Value="#E3E9F4" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Padding" Value="18,10" />
            </Style>

            <Style x:Key="ActiveChipStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Padding" Value="22,10" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#A9C2FF"
                            Offset="0,8"
                            Radius="16"
                            Opacity="0.45" />
                    </Setter.Value>
                </Setter>
            </Style>

        </ContentPage.Resources>

        <Grid RowDefinitions="*,Auto"
          BackgroundColor="{StaticResource PageBackground}">

            <!-- MAIN CONTENT -->
            <ScrollView Grid.Row="0"
                    VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="24,10,24,20"
                                 Spacing="0">

                <!-- CALENDAR CARD -->
                    <Border BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,26,26"
                        Padding="0,0,0,22"
                        Margin="-24,-6,-24,10">

                        <Border.Shadow>
                            <Shadow Brush="#D9E2F2"
                                Offset="0,10"
                                Radius="22"
                                Opacity="0.30" />
                        </Border.Shadow>

                        <VerticalStackLayout Padding="24,0,24,0"
                                         Spacing="22">

                            <!-- Month selector -->
                            <HorizontalStackLayout Spacing="8"
                                               Margin="0,0,0,0">
                                <Label Text="julio"
                                   FontFamily="InterSemiBold"
                                   FontSize="26"
                                   TextColor="{StaticResource TitleColor}" />

                                <Label Text="⌄"
                                   FontFamily="InterSemiBold"
                                   FontSize="22"
                                   TextColor="{StaticResource TitleColor}"
                                   VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Compact horizontal calendar -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                              ColumnSpacing="8"
                              Margin="0,0,0,0">

                                <!-- DOM -->
                                <VerticalStackLayout Grid.Column="0"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="dom"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 23">
                                        <Label Text="5"
                                           FontFamily="InterSemiBold"
                                           FontSize="22"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    </Border>

                                    <HorizontalStackLayout Spacing="4"
                                                       HorizontalOptions="Center">
                                        <Border WidthRequest="6"
                                            HeightRequest="6"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3" />
                                        <Border WidthRequest="6"
                                            HeightRequest="6"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- LUN -->
                                <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="lun"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="6"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="6"
                                        HeightRequest="6"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- MAR -->
                                <VerticalStackLayout Grid.Column="2"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="mar"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="7"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="6"
                                        HeightRequest="6"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- MIE -->
                                <VerticalStackLayout Grid.Column="3"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="mié"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="8"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <HorizontalStackLayout Spacing="4"
                                                       HorizontalOptions="Center">
                                        <Border WidthRequest="6"
                                            HeightRequest="6"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3" />
                                        <Border WidthRequest="6"
                                            HeightRequest="6"
                                            BackgroundColor="{StaticResource PrimaryColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 3" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- JUE -->
                                <VerticalStackLayout Grid.Column="4"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="jue"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="9"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="6"
                                        HeightRequest="6"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- VIE -->
                                <VerticalStackLayout Grid.Column="5"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="vie"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="10"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="6"
                                        HeightRequest="6"
                                        BackgroundColor="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- SAB -->
                                <VerticalStackLayout Grid.Column="6"
                                                 Spacing="8"
                                                 HorizontalOptions="Center">

                                    <Label Text="sáb"
                                       FontFamily="InterRegular"
                                       FontSize="15"
                                       TextColor="{StaticResource SubtitleColor}"
                                       HorizontalTextAlignment="Center" />

                                    <Label Text="11"
                                       FontFamily="InterSemiBold"
                                       FontSize="22"
                                       TextColor="{StaticResource TitleColor}"
                                       HeightRequest="46"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center" />

                                    <Border WidthRequest="6"
                                        HeightRequest="6"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 3"
                                        HorizontalOptions="Center" />
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SEARCH BAR -->
                    <Border BackgroundColor="{StaticResource SurfaceColor}"
                        Stroke="#E3E9F4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="12,0"
                        HeightRequest="52"
                        Margin="0,0,0,10">

                        <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          VerticalOptions="Center">

                            <Label Grid.Column="0"
                               Text="⌕"
                               FontSize="30"
                               TextColor="#667085"
                               VerticalOptions="Center" />

                            <Label Grid.Column="1"
                               Text="Buscar tarea..."
                               FontFamily="InterRegular"
                               FontSize="17"
                               TextColor="#8A94A6"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- COURSE + PRIORITY FILTERS -->
                    <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12"
                      
                      Margin="0,0,0,10">

                        <!-- Curso -->
                        <Border Grid.Column="0"
                            Style="{StaticResource FilterCardStyle}">

                            <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="5">

                                <Label Grid.Column="0"
                                   Grid.Row="0"
                                   Text="Curso"
                                   Style="{StaticResource SmallLabelStyle}" />

                                <Label Grid.Column="0"
                                   Grid.Row="1"
                                   Text="Todos"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   TextColor="{StaticResource TitleColor}" />

                                <Label Grid.Column="1"
                                   Grid.RowSpan="2"
                                   Text="⌄"
                                   FontSize="22"
                                   TextColor="{StaticResource SubtitleColor}"
                                   VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Prioridad -->
                        <Border Grid.Column="1"
                            Style="{StaticResource FilterCardStyle}">

                            <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="5">

                                <Label Grid.Column="0"
                                   Grid.Row="0"
                                   Text="Prioridad"
                                   Style="{StaticResource SmallLabelStyle}" />

                                <Label Grid.Column="0"
                                   Grid.Row="1"
                                   Text="Todas"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   TextColor="{StaticResource TitleColor}" />

                                <Label Grid.Column="1"
                                   Grid.RowSpan="2"
                                   Text="⌄"
                                   FontSize="22"
                                   TextColor="{StaticResource SubtitleColor}"
                                   VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- STATE FILTER CHIPS -->
                <ScrollView Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never"
                    Margin="0,0,0,0">

                    <HorizontalStackLayout Spacing="6">

                            <Border Style="{StaticResource ActiveChipStyle}">
                                <Label Text="Todo"
                                   FontFamily="InterSemiBold"
                                   FontSize="15"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                            <Border Style="{StaticResource ChipStyle}">
                                <Label Text="Pendientes"
                                   FontFamily="InterRegular"
                                   FontSize="15"
                                   TextColor="{StaticResource TitleColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                            <Border Style="{StaticResource ChipStyle}">
                                <Label Text="Vencidas"
                                   FontFamily="InterRegular"
                                   FontSize="15"
                                   TextColor="{StaticResource TitleColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                            <Border Style="{StaticResource ChipStyle}">
                                <Label Text="Completadas"
                                   FontFamily="InterRegular"
                                   FontSize="15"
                                   TextColor="{StaticResource TitleColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- SECTION: VENCIDAS -->
                    <Label Text="Vencidas"
                       Style="{StaticResource SectionTitleStyle}" />

                    <!-- Task without subtasks: shows completion circle -->
                    <Border Style="{StaticResource SoftCardStyle}"
                        Margin="0,0,0,10">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          VerticalOptions="Center">

                            <!-- Completion circle: only because this task has no subtasks -->
                            <Border Grid.Column="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="Transparent"
                                Stroke="#718096"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 19"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                             Spacing="6"
                                             VerticalOptions="Center">

                                <HorizontalStackLayout Spacing="9">
                                    <Border WidthRequest="10"
                                        HeightRequest="10"
                                        BackgroundColor="{StaticResource DangerColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 5"
                                        VerticalOptions="Center" />

                                    <Label Text="Informe de laboratorio"
                                       Style="{StaticResource TaskTitleStyle}" />
                                </HorizontalStackLayout>

                                <Label Text="Ciencia · 60 min"
                                   Style="{StaticResource TaskMetaStyle}" />

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="⚑"
                                       FontSize="14"
                                       TextColor="{StaticResource DangerColor}"
                                       VerticalOptions="Center" />

                                    <Label Text="Alta · Vencida"
                                       FontFamily="InterRegular"
                                       FontSize="14"
                                       TextColor="{StaticResource DangerColor}"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               TextColor="#718096"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- SECTION: PARA HOY -->
                    <Label Text="Para hoy"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,8,0,10" />

                    <!-- Task with subtasks: NO completion circle -->
                    <Border Style="{StaticResource SoftCardStyle}"
                        Margin="0,0,0,20">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          VerticalOptions="Center">

                            <!-- Icon instead of completion circle because this task has subtasks -->
                            <Border Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="{StaticResource PurpleLightColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                VerticalOptions="Center">

                                <Label Text="ƒ(x)"
                                   FontFamily="InterSemiBold"
                                   FontSize="18"
                                   TextColor="{StaticResource PurpleColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                             Spacing="6"
                                             VerticalOptions="Center">

                                <Label Text="Resolver álgebra lineal"
                                   Style="{StaticResource TaskTitleStyle}" />

                                <Label Text="Matemática · 18:00 · 45 min"
                                   Style="{StaticResource TaskMetaStyle}" />

                                <Label Text="3/5 subtareas"
                                   FontFamily="InterRegular"
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryColor}" />

                                <Grid HeightRequest="7"
                                  Margin="0,2,28,0">

                                    <Border BackgroundColor="#E8EDF6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        HeightRequest="7" />

                                    <Border BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        HeightRequest="7"
                                        WidthRequest="170"
                                        HorizontalOptions="Start" />
                                </Grid>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               TextColor="#718096"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Task without subtasks: shows completion circle -->
                    <Border Style="{StaticResource SoftCardStyle}"
                        Margin="0,0,0,20">

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          ColumnSpacing="14"
                          VerticalOptions="Center">

                            <!-- Completion circle: only because this task has no subtasks -->
                            <Border Grid.Column="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="Transparent"
                                Stroke="#718096"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 19"
                                VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="{StaticResource OrangeLightColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                VerticalOptions="Center">

                                <Label Text="▢"
                                   FontSize="22"
                                   TextColor="{StaticResource WarningColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="2"
                                             Spacing="6"
                                             VerticalOptions="Center">

                                <Label Text="Ensayo argumentativo"
                                   Style="{StaticResource TaskTitleStyle}" />

                                <Label Text="Comunicación · 30 min"
                                   Style="{StaticResource TaskMetaStyle}" />

                                <HorizontalStackLayout Spacing="8">
                                    <Border WidthRequest="8"
                                        HeightRequest="8"
                                        BackgroundColor="{StaticResource WarningColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        VerticalOptions="Center" />

                                    <Label Text="Media"
                                       FontFamily="InterRegular"
                                       FontSize="14"
                                       TextColor="{StaticResource SubtitleColor}"
                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="3"
                               Text="›"
                               FontSize="34"
                               TextColor="#718096"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- SECTION: SIN FECHA -->
                    <Label Text="Sin fecha"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,8,0,10" />

                    <!-- Task without subtasks: shows completion circle -->
                    <Border Style="{StaticResource SoftCardStyle}"
                        Margin="0,0,0,20">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          VerticalOptions="Center">

                            <Border Grid.Column="0"
                                WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="Transparent"
                                Stroke="#718096"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 19"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1"
                                             Spacing="6"
                                             VerticalOptions="Center">

                                <HorizontalStackLayout Spacing="9">
                                    <Border WidthRequest="10"
                                        HeightRequest="10"
                                        BackgroundColor="#22C55E"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 5"
                                        VerticalOptions="Center" />

                                    <Label Text="Leer capítulo de historia"
                                       Style="{StaticResource TaskTitleStyle}" />
                                </HorizontalStackLayout>

                                <Label Text="Historia · 25 min"
                                   Style="{StaticResource TaskMetaStyle}" />

                                <Label Text="Baja"
                                   FontFamily="InterRegular"
                                   FontSize="14"
                                   TextColor="{StaticResource SubtitleColor}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               TextColor="#718096"
                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- FLOATING ACTION BUTTON -->
        <Border Grid.Row="0"
                WidthRequest="68"
                HeightRequest="68"
                BackgroundColor="{StaticResource PrimaryColor}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 34"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,26,100"
                ZIndex="20">

            <Border.Shadow>
                <Shadow Brush="#7DA2FF"
                        Offset="0,12"
                        Radius="24"
                        Opacity="0.55" />
            </Border.Shadow>

            <Label Text="+"
                   FontSize="42"
                   FontFamily="InterRegular"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,-4,0,0" />
        </Border>

    </Grid>
    </ContentPage>