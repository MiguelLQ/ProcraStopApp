<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.CreateTask"
             Title="CreateTask">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="14,0,14,25" Spacing="14">
                
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="20"
                    Stroke="#EEF0F6"
                    StrokeThickness="1"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Detalles principales"
                                TextColor="#111827"
                                />
                            <Label
                                FontSize="13"
                                Text="Escribe una tarea concreta y fácil de entender."
                                TextColor="#8A91A3"
                                />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Nombre"
                                TextColor="#374151"
                                />
                            <Border
                                BackgroundColor="#F7F8FC"
                                Padding="14,2"
                                Stroke="#EEF0F6"
                                StrokeThickness="1"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Entry
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    HeightRequest="48"
                                    Placeholder="Ej. Resolver ejercicios de integrales"
                                    PlaceholderColor="#A0A7B5"
                                    Text="{Binding Title}"
                                    TextColor="#111827"
                                    />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Descripción"
                                TextColor="#374151"
                                />
                            <Border
                                BackgroundColor="#F7F8FC"
                                Padding="14,8"
                                Stroke="#EEF0F6"
                                StrokeThickness="1"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Editor
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    MinimumHeightRequest="88"
                                    Placeholder="Agrega una nota opcional..."
                                    PlaceholderColor="#A0A7B5"
                                    Text="{Binding Description}"
                                    TextColor="#111827"
                                    />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="20"
                    Stroke="#EEF0F6"
                    StrokeThickness="1"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Planificación"
                                    TextColor="#111827"
                                    />
                                <Label
                                    FontSize="13"
                                    Text="Define cuándo quieres terminarla."
                                    TextColor="#8A91A3"
                                    />
                            </VerticalStackLayout>
                            <Border
                                BackgroundColor="#EEF2FF"
                                Grid.Column="1"
                                Padding="12,7"
                                VerticalOptions="Start"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Fecha"
                                    TextColor="#4F46E5"
                                    />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="Fecha límite"
                                    TextColor="#111827"
                                    />
                                <Label
                                    FontSize="12"
                                    Text="Activa una fecha y hora para organizar tu avance."
                                    TextColor="#8A91A3"
                                    />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding HasDueDate}"
                                OnColor="#4F46E5"
                                ThumbColor="#FFFFFF"
                                VerticalOptions="Center"
                                />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding HasDueDate}" Spacing="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border
                                    BackgroundColor="#F7F8FC"
                                    Padding="14"
                                    Stroke="#EEF0F6"
                                    StrokeThickness="1"
                                    >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="Fecha"
                                            TextColor="#8A91A3"
                                            />
                                        <DatePicker
                                            BackgroundColor="Transparent"
                                            Date="{Binding SelectedDueDate}"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            TextColor="#111827"
                                            />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    BackgroundColor="#F7F8FC"
                                    Grid.Column="1"
                                    Padding="14"
                                    Stroke="#EEF0F6"
                                    StrokeThickness="1"
                                    >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="Hora"
                                            TextColor="#8A91A3"
                                            />
                                        <TimePicker
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            TextColor="#111827"
                                            Time="{Binding SelectedDueTime}"
                                            />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Border
                                BackgroundColor="#EEF2FF"
                                Padding="14,12"
                                StrokeThickness="0"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label
                                        FontSize="17"
                                        Text="📅"
                                        VerticalOptions="Center"
                                        />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Grid.Column="1"
                                        Text="{Binding DueDatePreviewText}"
                                        TextColor="#4F46E5"
                                        VerticalOptions="Center"
                                        />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Recordatorio"
                                    TextColor="#374151"
                                    />
                                <Border
                                    BackgroundColor="#F7F8FC"
                                    Padding="14,2"
                                    Stroke="#EEF0F6"
                                    StrokeThickness="1"
                                    >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Picker
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        ItemsSource="{Binding ReminderOffsets}"
                                        SelectedIndex="{Binding SelectedReminderOffsetIndex}"
                                        TextColor="#111827"
                                        Title="Selecciona cuándo avisarte"
                                        TitleColor="#A0A7B5"
                                        />
                                </Border>
                                <Label
                                    FontSize="12"
                                    Margin="4,0,0,0"
                                    Text="{Binding ReminderPreviewText}"
                                    TextColor="#8A91A3"
                                    />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="20"
                    Stroke="#EEF0F6"
                    StrokeThickness="1"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Organización"
                                TextColor="#111827"
                                />
                            <Label
                                FontSize="13"
                                Text="Clasifica la tarea para encontrarla más rápido."
                                TextColor="#8A91A3"
                                />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="Curso"
                                TextColor="#374151"
                                />
                            <Border
                                BackgroundColor="#F7F8FC"
                                Padding="14,2"
                                Stroke="#EEF0F6"
                                StrokeThickness="1"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Picker
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Courses}"
                                    SelectedItem="{Binding SelectedCourse}"
                                    TextColor="#111827"
                                    Title="Selecciona curso"
                                    TitleColor="#A0A7B5"
                                    />
                            </Border>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Prioridad"
                                    TextColor="#374151"
                                    />
                                <Border
                                    BackgroundColor="#FFF7ED"
                                    Padding="14,2"
                                    Stroke="#FED7AA"
                                    StrokeThickness="1"
                                    >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Picker
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        ItemsSource="{Binding Priorities}"
                                        SelectedItem="{Binding SelectedPriority}"
                                        TextColor="#EA580C"
                                        Title="Prioridad"
                                        TitleColor="#C2410C"
                                        />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Tiempo"
                                    TextColor="#374151"
                                    />
                                <Border
                                    BackgroundColor="#ECFDF5"
                                    Padding="14,2"
                                    Stroke="#A7F3D0"
                                    StrokeThickness="1"
                                    >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Entry
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        HeightRequest="48"
                                        Keyboard="Numeric"
                                        Placeholder="60 min"
                                        PlaceholderColor="#059669"
                                        Text="{Binding EstimatedMinutesText}"
                                        TextColor="#059669"
                                        />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#FFFFFF"
                    Padding="20"
                    Stroke="#EEF0F6"
                    StrokeThickness="1"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Subtareas"
                                    TextColor="#111827"
                                    />
                                <Label
                                    FontSize="13"
                                    Text="Divide para empezar con menos fricción."
                                    TextColor="#8A91A3"
                                    />
                            </VerticalStackLayout>
                            <Border
                                BackgroundColor="#EEF2FF"
                                Grid.Column="1"
                                Padding="12,7"
                                VerticalOptions="Start"
                                >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="Opcional"
                                    TextColor="#4F46E5"
                                    />
                            </Border>
                        </Grid>
                        <Border
                            BackgroundColor="#F7F8FC"
                            Padding="14,2"
                            Stroke="#EEF0F6"
                            StrokeThickness="1"
                            >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Entry
                                    BackgroundColor="Transparent"
                                    FontSize="14"
                                    HeightRequest="48"
                                    Placeholder="Nueva subtarea..."
                                    PlaceholderColor="#A0A7B5"
                                    Text="{Binding NewSubtaskText}"
                                    TextColor="#111827"
                                    />
                                <Button
                                    BackgroundColor="#111827"
                                    Command="{Binding AddSubtaskCommand}"
                                    CornerRadius="19"
                                    FontSize="20"
                                    Grid.Column="1"
                                    HeightRequest="38"
                                    Text="+"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="Center"
                                    WidthRequest="38"
                                    />
                            </Grid>
                        </Border>
                        <CollectionView ItemsSource="{Binding Subtasks}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13" Padding="0,8">
                                        <Border WidthRequest="28" HeightRequest="28" BackgroundColor="#EEF2FF" Stroke="#C7D2FE" StrokeThickness="1" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Label Text="○" FontSize="14" FontAttributes="Bold" TextColor="#4F46E5" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-1,0,0" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding .}" FontSize="15" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" />
                                            <Label Text="Pendiente" FontSize="12" TextColor="#8A91A3" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="✕"  WidthRequest="32" HeightRequest="32" CornerRadius="16" BackgroundColor="#FEF2F2" TextColor="#DC2626" FontSize="13" Padding="0" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Border
                    BackgroundColor="#FFF7ED"
                    Padding="18"
                    Stroke="#FED7AA"
                    StrokeThickness="1"
                    >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border
                            BackgroundColor="#FFFFFF"
                            HeightRequest="46"
                            StrokeThickness="0"
                            VerticalOptions="Start"
                            WidthRequest="46"
                            >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="23" />
                            </Border.StrokeShape>
                            <Label
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="💡"
                                VerticalOptions="Center"
                                />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="7">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Consejo ProcraStop"
                                TextColor="#111827"
                                />
                            <Label
                                FontSize="13"
                                LineHeight="1.25"
                                Text="Si una tarea tarda más de 45 minutos, divídela en subtareas pequeñas. Será más fácil empezar y mantener el enfoque."
                                TextColor="#92400E"
                                />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <ActivityIndicator
                    Color="#4F46E5"
                    HeightRequest="36"
                    IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"
                    />
            </VerticalStackLayout>
        </ScrollView>
        <Border
            BackgroundColor="#FFFFFF"
            Grid.Row="1"
            Margin="16,0,16,18"
            Padding="20,14"
            Stroke="#EEF0F6"
            StrokeThickness="1"
            >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="Lista para guardar"
                        TextColor="#111827"
                        />
                    <Label
                        FontSize="12"
                        Text="Revisa los datos antes de continuar"
                        TextColor="#8A91A3"
                        />
                </VerticalStackLayout>
                <Button
                    BackgroundColor="#111827"
                    Command="{Binding SaveCommand}"
                    CornerRadius="22"
                    FontAttributes="Bold"
                    FontSize="14"
                    Grid.Column="1"
                    HeightRequest="48"
                    IsEnabled="{Binding CanSave}"
                    Padding="22,0"
                    Text="Guardar"
                    TextColor="#FFFFFF"
                    VerticalOptions="Center"
                    />
            </Grid>
        </Border>
    </Grid>
</ContentPage>