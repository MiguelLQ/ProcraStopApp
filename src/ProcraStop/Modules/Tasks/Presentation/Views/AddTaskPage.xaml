<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.AddTaskPage"
             Title="AddTaskPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- FORMULARIO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="0" BackgroundColor="White">

                <!-- Task Title -->
                <Entry Placeholder="Task Title"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1A1A2E"
                       PlaceholderColor="#BDBDBD"
                       BackgroundColor="Transparent"
                       Margin="0,0,0,12"/>

                <!-- Separador -->
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,6"/>

                <!-- Description -->
                <Border BackgroundColor="#F8F9FF"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E8EAF0"
                        Padding="14"
                        Margin="0,0,0,20">
                    <Editor Placeholder="Description"
                            HeightRequest="60"
                            FontSize="15"
                            TextColor="#333"
                            PlaceholderColor="#BDBDBD"
                            BackgroundColor="Transparent"/>
                </Border>

                <!-- Subject -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="Subject"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="Math" FontSize="15" TextColor="#666"/>
                        <Label Text="∨" FontSize="15" TextColor="#4B5BDB"/>
                    </HorizontalStackLayout>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Due Date -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="Due Date"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <Border Grid.Column="1"
                            BackgroundColor="#F0F2F8"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#E0E0E0"
                            Padding="12,6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="April 25, 2024" FontSize="14" TextColor="#4B5BDB" VerticalOptions="Center"/>
                            <Label Text="∨" FontSize="13" TextColor="#4B5BDB" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Time -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="Time"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <Border Grid.Column="1"
                            BackgroundColor="#F0F2F8"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#E0E0E0"
                            Padding="12,6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="3:00 PM" FontSize="14" TextColor="#4B5BDB" VerticalOptions="Center"/>
                            <Label Text="∨" FontSize="13" TextColor="#4B5BDB" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Priority -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="Priority"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <!-- Segmented buttons -->
                    <Border Grid.Column="1"
                            BackgroundColor="#F0F2F8"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#E0E0E0"
                            Padding="4">
                        <HorizontalStackLayout Spacing="4">
                            <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent" Padding="10,6">
                                <Label Text="Low" FontSize="13" TextColor="#888"/>
                            </Border>
                            <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent" Padding="10,6">
                                <Label Text="Medium" FontSize="13" TextColor="#888"/>
                            </Border>
                            <Border BackgroundColor="#4B5BDB" StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent" Padding="10,6">
                                <Label Text="High" FontSize="13" TextColor="White" FontAttributes="Bold"/>
                            </Border>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Remind Me -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="🔔" FontSize="20" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Remind Me"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <!-- Toggle ON simulado -->
                    <Border Grid.Column="2"
                            BackgroundColor="#4B5BDB"
                            StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            WidthRequest="52" HeightRequest="28"
                            VerticalOptions="Center">
                        <Grid>
                            <Ellipse Fill="White" WidthRequest="22" HeightRequest="22"
                                     HorizontalOptions="End" Margin="0,0,3,0"/>
                        </Grid>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Repeat -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                    <Label Grid.Column="0" Text="🔄" FontSize="20" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Repeat"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <!-- Toggle OFF simulado -->
                    <Border Grid.Column="2"
                            BackgroundColor="#CCCCCC"
                            StrokeShape="RoundRectangle 14"
                            Stroke="Transparent"
                            WidthRequest="52" HeightRequest="28"
                            VerticalOptions="Center">
                        <Grid>
                            <Ellipse Fill="White" WidthRequest="22" HeightRequest="22"
                                     HorizontalOptions="Start" Margin="3,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="#EFEFEF" Margin="0,0,0,16"/>

                <!-- Subtasks -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,24">
                    <Label Grid.Column="0" Text="⊞" FontSize="20" TextColor="#4B5BDB" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="Subtasks"
                           FontSize="16" FontAttributes="Bold" TextColor="#1A1A2E"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="+" FontSize="24" TextColor="#4B5BDB" VerticalOptions="Center"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTONES INFERIORES -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*"
              ColumnSpacing="12" Padding="20,12,20,40"
              BackgroundColor="White">
            <!-- Sombra -->
            <BoxView Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#EEEEEE" VerticalOptions="Start"/>

            <Button Grid.Column="0"
                    Text="Save Task"
                    BackgroundColor="#4B5BDB"
                    TextColor="White"
                    FontSize="16" FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"/>
            <Button Grid.Column="1"
                    Text="Save &amp; Add Another"
                    BackgroundColor="White"
                    TextColor="#4B5BDB"
                    FontSize="14"
                    BorderColor="#4B5BDB"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="52"/>
        </Grid>

    </Grid>
</ContentPage>