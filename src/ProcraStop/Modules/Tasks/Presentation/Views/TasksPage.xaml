<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             xmlns:controls="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Controls"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TasksPage"
             xmlns:base="clr-namespace:ProcraStop.Shared.UI.Layouts"
             Title="Lista de tareas"
                 Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource EntryDark}}"
             Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <Grid Padding="0,0,0,0"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="10">
        <!-- editbycodex: buscador nuevo simplificado; reemplaza el header anterior oculto para evitar capas que bloqueen foco. -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource EntryDark}}"
                StrokeThickness="0"
                Padding="16,10,16,12"
                StrokeShape="RoundRectangle 0,0,32,32">

            <VerticalStackLayout Spacing="6">
                <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#333847}"
                        Stroke="#8A94A6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        HeightRequest="46"
                        Padding="0">

                    <!-- editbycodex: SearchBar nativo enfocable; reemplaza el falso buscador estatico. -->
                    <SearchBar Text="{Binding SearchText}"
                               Placeholder="Buscar tarea..."
                               PlaceholderColor="#8A94A6"
                               FontFamily="InterRegular"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
                               BackgroundColor="Transparent"
                               CancelButtonColor="{StaticResource primarioS}"
                               SearchCommand="{Binding SearchCommand}" />
                </Border>

                <Label Text="{Binding SearchSummaryText}"
                       IsVisible="{Binding IsSearchActive}"
                       FontFamily="ManropeRegular"
                       FontSize="12"
                       Margin="4,0,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
            </VerticalStackLayout>
        </Border>
        <!-- calendario profesional -->
        <controls:TaskCalendarView Grid.Row="1"
                           Margin="10,0,10,0"
                           VisibleMonthText="{Binding VisibleMonthText}"
                           WeekDays="{Binding WeekDays}"
                           MonthDays="{Binding MonthDays}"
                           IsExpanded="{Binding IsCalendarExpanded}"
                           IsCompactVisible="{Binding IsCompactCalendarVisible}"
                           ToggleCalendarCommand="{Binding ToggleCalendarCommand}"
                           PreviousMonthCommand="{Binding PreviousMonthCommand}"
                           NextMonthCommand="{Binding NextMonthCommand}"
                           SelectDateCommand="{Binding SelectDateCommand}" />
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <!-- FILTROS DINÁMICOS LIGEROS -->
            <CollectionView
                    
                    ItemsSource="{Binding Filters}"
                    ItemsLayout="HorizontalList"
                    HorizontalOptions="Fill"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,0,0,0">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskFilterChip">
                        <Border StrokeThickness="0"
                                Margin="0,0,10,0"
                                Padding="0"
                                HeightRequest="35"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#333847}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
Command="{Binding Source={RelativeSource AncestorType={x:Type base:BasePage}}, Path=BindingContext.ChangeFilterCommand}"
CommandParameter="{Binding Filter}" />
                            </Border.GestureRecognizers>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
     Binding="{Binding IsSelected}"
     Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource primarioS}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Label Text="{Binding Title}"
   Padding="16,8"
   FontSize="13"
   FontAttributes="Bold"
   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}">

                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
         Binding="{Binding IsSelected}"
         Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>


        <!-- TASK LIST -->
        <Grid Grid.Row="3" Margin="10,0,10,0">

            <CollectionView ItemsSource="{Binding Tasks}"
                    SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                        <Label Text="No tienes tareas todavía"
                       HorizontalOptions="Center"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

                        <Label Text="Crea tu primera tarea para empezar."
                       HorizontalOptions="Center"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- 1 card por fila -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                               ItemSpacing="1" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="12"
                        Margin="0,0,0,5"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        StrokeShape="RoundRectangle 20"
                        MinimumHeightRequest="100">

                            <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                                  RowSpacing="2"
                                  >

                                <!-- editbycodex: pin y completado rapido comparten una columna estable. -->
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="8"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Start">
                                <Border
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource shipsligth}, Dark={StaticResource DarkBackground}}"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start"
                                HorizontalOptions="Center">

                                    <Label Text="📌"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                                </Border>

                                    <Grid IsVisible="{Binding HasNoSubtasks}"
                                          WidthRequest="34"
                                          HeightRequest="34">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompleteFromListCommand}"
                                                CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>

                                        <!-- editbycodex: check nativo, solo lectura visual; el comando guarda antes de actualizar. -->
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  IsEnabled="{Binding CanQuickComplete}"
                                                  InputTransparent="True"
                                                  Color="{StaticResource primarioS}"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- CONTENIDO -->
                                <Grid Grid.Column="1"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="1">

                                    <Grid.GestureRecognizers>
                                        <!-- editbycodex: abrir detalle queda separado del area del check. -->
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                            CommandParameter="{Binding Id}" />
                                    </Grid.GestureRecognizers>

                                    <!-- TOP BADGES -->
                                    <Grid Grid.Row="0"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8">

                                        <Border Padding="8,4"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource shipsligth}, Dark={StaticResource DarkBackground}}"
                                            StrokeShape="RoundRectangle 12"
                                            HorizontalOptions="Start">

                                            <Label Text="{Binding PriorityText}"
                                                   FontSize="10"
                                                   FontFamily="LatoBold"
                                                   TextColor="{Binding PriorityColorHex}" />

                                        </Border>
                                        <!-- Curso -->
                                        <Border Grid.Column="1"
                                            IsVisible="{Binding HasCourse}"
                                            Padding="8,4"
                                            StrokeShape="RoundRectangle 10"
                                            Background="{Binding CourseColor}"
                                            VerticalOptions="Center">

                                            <HorizontalStackLayout Spacing="6"
                                               VerticalOptions="Center">

                                                <BoxView WidthRequest="6"
                                                     HeightRequest="6"
                                                     CornerRadius="2"
                                                     Background="Transparent"
                                                     Color="{Binding CourseColor}" />

                                                <Label Text="Curso:"
                                                   FontSize="11"
                                                   FontFamily="MontserratRegular"
                                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                                                <Label Text="{Binding CourseName}"
                                                   FontSize="11"
                                                   FontFamily="OpenSansRegular"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   TextColor="{Binding CourseColor}" />

                                            </HorizontalStackLayout>

                                        </Border>

                                        <Label Grid.Column="2"
                                       Text="{Binding StatusText}"
                                       FontSize="12"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"
                                       FontFamily="OpenSansRegular"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{Binding StatusColorHex}" />

                                    </Grid>

                                    <!-- TITLE -->
                                    <Label Grid.Row="1"
                                   Text="{Binding Title}"
                                   FontSize="15"
                                   FontFamily="MontserratSemiBold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />

                                    <!-- INFO PRINCIPAL -->
                                    <Grid Grid.Row="2"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">

                                        <!-- Fecha principal -->
                                        <HorizontalStackLayout Grid.Column="0"
                                                       Spacing="6"
                                                       VerticalOptions="Center">

                                            <Label Text="⏰"
                                           FontSize="12" />

                                            <Label Text="{Binding DueDatePrimaryText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                                        </HorizontalStackLayout>

                                        

                                    </Grid>

                                    <!-- INFO SECUNDARIA -->
                                    <Grid Grid.Row="3"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">

                                        <!-- Tiempo estimado -->
                                        <HorizontalStackLayout Grid.Column="0"
                                           Spacing="6"
                                           VerticalOptions="Center">

                                            <Label Text="⏳"
                                                   FontSize="12" />

                                            <Label Text="{Binding EstimatedMinutesText}"
                                               FontSize="12"
                                               FontFamily="MontserratRegular"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />

                                        </HorizontalStackLayout>
                                        <!-- Fecha relativa -->
                                        <Label Grid.Column="1"
                                       Text="{Binding DueDateRelativeText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{Binding DueDateRelativeColorHex}"
                                       IsVisible="{Binding HasDueDateRelativeText}"
                                       VerticalOptions="Center" />

                                        

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- FAB FLOTANTE REAL (SUPERPUESTO, SIN RESERVAR ESPACIO) -->
            <Button Text="+"
                    Clicked="OnAddTaskClicked"
                    BackgroundColor="{StaticResource primarioS}"
                    TextColor="{StaticResource White}"
                    FontSize="28"
                    WidthRequest="70"
                    HeightRequest="70"
                    CornerRadius="40"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    ZIndex="10" />
        </Grid>

    </Grid>
</base:BasePage>
