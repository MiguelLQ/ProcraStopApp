<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:f="clr-namespace:Fonts"
               xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
               xmlns:controls="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Controls"
               xmlns:viewModels="clr-namespace:ProcraStop.Modules.Tasks.Presentation.ViewModels"
               xmlns:base="clr-namespace:ProcraStop.Shared.UI.Layouts"
               x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TasksPage"
               x:DataType="viewModels:TasksPageViewModel"
               Title="Mis tareas"
               Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
               Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
               Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
               BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <base:BasePage.ToolbarItems>
        <ToolbarItem Text="Calendario"
                     IconImageSource="{StaticResource IconCalendar}"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding ToggleCalendarCommand}" />
    </base:BasePage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="0,6,0,0">
        <Grid Grid.Row="0" Margin="18,0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="1">
                <Label Text="Agenda del día"
                       FontFamily="MontserratSemiBold"
                       FontSize="21"
                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                <Label Text="{Binding SelectedDate, StringFormat='{0:dddd, dd MMMM}'}"
                       FontFamily="ManropeRegular"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" Padding="10,5" StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#272A3D}"
                    VerticalOptions="Center">
                <Label Text="{Binding Tasks.Count, StringFormat='{0} tareas'}"
                       FontFamily="ManropeSemiBold" FontSize="12"
                       TextColor="{StaticResource primarioS}" />
            </Border>
        </Grid>

        <!-- La semana compacta siempre queda visible; el botón del navbar despliega el mes. -->
        <controls:TaskCalendarView Grid.Row="1"
                                   Margin="8,0"
                                   VisibleMonthText="{Binding VisibleMonthText}"
                                   WeekDays="{Binding WeekDays}"
                                   MonthDays="{Binding MonthDays}"
                                   IsExpanded="{Binding IsCalendarExpanded}"
                                   IsCompactVisible="{Binding IsCompactCalendarVisible}"
                                   ToggleCalendarCommand="{Binding ToggleCalendarCommand}"
                                   PreviousMonthCommand="{Binding PreviousMonthCommand}"
                                   NextMonthCommand="{Binding NextMonthCommand}"
                                   SelectDateCommand="{Binding SelectDateCommand}" />

        <CollectionView Grid.Row="2" Margin="14,0"
                        ItemsSource="{Binding Filters}"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None"
                        HorizontalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskFilterChip">
                    <Border HeightRequest="34" Margin="0,0,8,0" Padding="14,7"
                            StrokeThickness="0" StrokeShape="RoundRectangle 17"
                            BackgroundColor="{AppThemeBinding Light=#F1F3F7, Dark=#333847}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeFilterCommand, Source={RelativeSource AncestorType={x:Type viewModels:TasksPageViewModel}}}"
                                                  CommandParameter="{Binding Filter}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource primarioS}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Title}" FontFamily="ManropeSemiBold" FontSize="12"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#D1D5DB}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            Margin="6,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8"
                                         HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No hay tareas en esta vista"
                               HorizontalOptions="Center"
                               FontFamily="MontserratSemiBold" FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                        <Label Text="Selecciona otro día o crea una tarea."
                               HorizontalOptions="Center" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskItemModel">
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="7" Padding="0,3,0,6">
                            <!-- Hora y línea de agenda -->
                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="4">
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <Label Text="{Binding TimelineTimeText}"
                                           FontFamily="ManropeSemiBold" FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#334155, Dark=#E5E7EB}" />
                                    <Label Text="{Binding TimelinePeriodText}"
                                           FontSize="9" HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#6B7280}" />
                                </VerticalStackLayout>
                                <Grid Grid.Row="1" WidthRequest="14" HorizontalOptions="Center">
                                    <BoxView WidthRequest="1" HorizontalOptions="Center" VerticalOptions="Fill"
                                             Color="{AppThemeBinding Light=#DDE3EC, Dark=#3D4353}" />
                                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Start"
                                             Fill="{Binding PriorityColorHex}" />
                                </Grid>
                            </Grid>

                            <!-- Una sola plantilla adaptable evita congelar la UI al buscar o mostrar Sin fecha. -->
                            <Border Grid.Column="1" Margin="0,0,5,7" Padding="14,11"
                                    MinimumHeightRequest="108"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsGroupTask}" Value="True">
                                        <Setter Property="MinimumHeightRequest" Value="142" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEF1FF, Dark=#272A46}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <!-- Esta zona abre el detalle; queda separada del check para evitar doble navegación. -->
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenDetailCommand, Source={RelativeSource AncestorType={x:Type viewModels:TasksPageViewModel}}}"
                                                                  CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="6">
                                            <Border Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{StaticResource primarioS}"
                                                    IsVisible="{Binding IsGroupTask}">
                                                <Label Text="GRUPAL" FontFamily="ManropeSemiBold" FontSize="9" TextColor="White" />
                                            </Border>
                                            <Border Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark={StaticResource DarkBackground}}">
                                                <Label Text="{Binding PriorityText}" FontFamily="LatoBold" FontSize="10"
                                                       TextColor="{Binding PriorityColorHex}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" Text="{Binding Title}" MaxLines="2"
                                               FontFamily="MontserratSemiBold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                                        <Label Grid.Row="2" Text="{Binding CourseName}" MaxLines="1"
                                               IsVisible="{Binding HasCourse}"
                                               FontFamily="ManropeRegular" FontSize="11"
                                               TextColor="{Binding CourseColor}" />
                                        <HorizontalStackLayout Grid.Row="3" Spacing="7"
                                                               IsVisible="{Binding HasGroupMember}">
                                            <Border WidthRequest="27" HeightRequest="27" Padding="0"
                                                    StrokeThickness="2" Stroke="White"
                                                    StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{StaticResource primarioS}">
                                                <Label Text="{Binding GroupMemberInitials}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       FontFamily="ManropeSemiBold" FontSize="9" TextColor="White" />
                                            </Border>
                                            <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                                                <Label Text="Con un compañero" FontSize="9"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#AAB2C2}" />
                                                <Label Text="{Binding GroupMemberName}" FontFamily="ManropeSemiBold" FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Label Text="{Binding EstimatedMinutesText}" FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                            <Label Grid.Column="1" Text="{Binding StatusText}" FontFamily="ManropeSemiBold"
                                                   FontSize="10" TextColor="{Binding StatusColorHex}" />
                                        </Grid>
                                        <Border Grid.Row="5" IsVisible="{Binding HasStartWarning}"
                                                Padding="8,4" Margin="0,1,0,0"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#3A2E12}">
                                            <Label Text="{Binding StartWarningText}"
                                                   FontFamily="ManropeSemiBold" FontSize="10"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Column="1" IsVisible="{Binding HasNoSubtasks}"
                                          WidthRequest="36" HeightRequest="36" VerticalOptions="Start">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CompleteFromListCommand, Source={RelativeSource AncestorType={x:Type viewModels:TasksPageViewModel}}}"
                                                                  CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  IsEnabled="{Binding CanQuickComplete}"
                                                  InputTransparent="True"
                                                  Color="{StaticResource primarioS}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Campo simple y ligero; evita el bloqueo nativo observado con SearchBar. -->
            <Border IsVisible="{Binding IsSearchPanelOpen}"
                    Margin="14,0,14,16" Padding="14,0,4,0" HeightRequest="52"
                    HorizontalOptions="Fill" VerticalOptions="End"
                    StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D4353}"
                    StrokeShape="RoundRectangle 26"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#252A36}"
                    ZIndex="20">
                <Grid ColumnDefinitions="Auto,*,42" ColumnSpacing="8">
                    <Label Text="{x:Static f:FluentUI.search_24_regular}"
                           FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20"
                           VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                    <Entry x:Name="SearchInput" Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Buscar tarea..."
                           ReturnType="Search"
                           ClearButtonVisibility="WhileEditing"
                           BackgroundColor="Transparent"
                           FontFamily="InterRegular" FontSize="14" />
                    <Label Grid.Column="2" Text="×" FontSize="26"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseSearchPanelCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Acciones contextuales de esta página, fuera del Shell. -->
            <Grid IsVisible="{Binding IsSearchPanelOpen, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalOptions="Fill" VerticalOptions="End" ZIndex="20">
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="End"
                                       Margin="0,0,14,16" Spacing="10">
                    <Border WidthRequest="52" HeightRequest="52" Padding="0" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D4353}"
                            StrokeShape="RoundRectangle 26"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#252A36}">
                        <Label Text="{x:Static f:FluentUI.search_24_regular}"
                               FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="22"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#334155, Dark=#F8FAFC}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchButtonTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border WidthRequest="56" HeightRequest="56" Padding="0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            BackgroundColor="{StaticResource primarioS}"
                            Shadow="{Shadow Brush=#50000000, Offset='0,4', Radius=10, Opacity=0.35}">
                        <Label Text="+" FontFamily="InterRegular" FontSize="34"
                               TranslationY="-2"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="White" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddTaskTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</base:BasePage>
