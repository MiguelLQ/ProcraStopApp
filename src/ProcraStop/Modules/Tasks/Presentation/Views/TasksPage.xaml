<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TasksPage"
             Title="Mis tareas"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Mis tareas"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

            <Label Text="Organiza tus pendientes y vencimientos"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <!-- FILTROS DINÁMICOS LIGEROS -->
        <CollectionView Grid.Row="1"
                ItemsSource="{Binding Filters}"
                ItemsLayout="HorizontalList"
                SelectionMode="None"
                HorizontalScrollBarVisibility="Never"
                Margin="0,4,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TaskFilterOption">
                    <Border StrokeThickness="0"
                    Margin="0,0,10,0"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ChangeFilterCommand}"
                        CommandParameter="{Binding Filter}" />
                        </Border.GestureRecognizers>

                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                 Binding="{Binding IsSelected}"
                                 Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label Text="{Binding Title}"
                       Padding="16,8"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}">

                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                     Binding="{Binding IsSelected}"
                                     Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- TASK LIST -->
        <Grid Grid.Row="2">

            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No tienes tareas todavía"
                               HorizontalOptions="Center"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />
                        <Label Text="Crea tu primera tarea para empezar."
                               HorizontalOptions="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- 2 cards por fila -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     VerticalItemSpacing="12"
                                     HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                StrokeShape="RoundRectangle 18"
                                MinimumHeightRequest="245">

                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                                  RowSpacing="8">

                                <!-- TOP BADGES -->
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">

                                    <Border Padding="8,4"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource MidnightBlue}}"
                                            StrokeShape="RoundRectangle 12"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding PriorityText}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="{Binding PriorityColorHex}" />
                                    </Border>

                                    <Label Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding StatusColorHex}" />
                                </Grid>

                                <!-- TITLE -->
                                <Label Grid.Row="1"
                                       Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />

                                <!-- DESCRIPTION -->
                                <Label Grid.Row="2"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding HasDescription}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                                <!-- CONTENT -->
                                <VerticalStackLayout Grid.Row="3"
                                                     Spacing="8">

                                    <!-- Fecha principal -->
                                    <Border Padding="8,6"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource Gray900}}"
                                            StrokeShape="RoundRectangle 12">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="⏰"
                                                   FontSize="12" />
                                            <Label Text="{Binding DueDatePrimaryText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Fecha relativa -->
                                    <Label Text="{Binding DueDateRelativeText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding DueDateRelativeColorHex}"
                                           IsVisible="{Binding HasDueDateRelativeText}" />

                                    <!-- Tiempo estimado -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⏳"
                                               FontSize="12" />
                                        <Label Text="{Binding EstimatedMinutesText}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                    </HorizontalStackLayout>

                                    <!-- Overdue -->
                                    <Label Text="{Binding OverdueText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="#DC2626"
                                           IsVisible="{Binding ShowOverdue}" />
                                </VerticalStackLayout>

                                <!-- ACTIONS -->
                                <Grid Grid.Row="4"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8"
                                      Margin="0,4,0,0">

                                    <Button Grid.Column="0"
                                            Text="Completar"
                                            IsVisible="{Binding CanComplete}"
                                            HeightRequest="38"
                                            FontSize="12"
                                            CornerRadius="14"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="{StaticResource White}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompleteCommand}"
                                            CommandParameter="{Binding Id}" />

                                    <Button Grid.Column="1"
                                            Text="Archivar"
                                            HeightRequest="38"
                                            FontSize="12"
                                            CornerRadius="14"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource Gray600}}"
                                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ArchiveCommand}"
                                            CommandParameter="{Binding Id}" />
                                </Grid>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FAB FLOTANTE REAL (SUPERPUESTO, SIN RESERVAR ESPACIO) -->
            <Button Text="+"
                    Clicked="OnAddTaskClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontSize="28"
                    WidthRequest="70"
                    HeightRequest="70"
                    CornerRadius="40"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,8,8"
                    ZIndex="10" />
        </Grid>

    </Grid>
</ContentPage>