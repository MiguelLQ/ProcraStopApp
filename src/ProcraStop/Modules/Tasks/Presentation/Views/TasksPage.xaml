<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Models"
             x:Class="ProcraStop.Modules.Tasks.Presentation.Views.TasksPage"
             xmlns:base="clr-namespace:ProcraStop.Shared.UI.Layouts"
             Title="Lista de tareas"
                 Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource EntryDark}}"
             Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <Grid Padding="0,0,0,0"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0"  Spacing="4" MinimumHeightRequest="70">
            <Grid>
                <Grid
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource EntryDark}}"
                    HeightRequest="40"
                     InputTransparent="True"
                    Padding="0,0"
                    RowDefinitions="Auto,*"
                    >
                    <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource EntryDark}}"
                        Grid.RowSpan="0"

                        HeightRequest="90"
                        Padding="20,0,15,-20"
                        >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="0.62*,0.16*,0.15*" RowDefinitions="*">
                                <VerticalStackLayout >
                                    <!--<Label Text="Mi lista de tareas"
                                       FontSize="20"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />-->

                                    <Label Text="Organiza tus pendientes y vencimientos de tareas y reduce la procrastinación 😉..."
                                       FontSize="15"
                                       FontFamily="ManropeRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                </VerticalStackLayout>
                                <Button
                                    BackgroundColor="Gray"
                                    CornerRadius="8"
                                    FontSize="14"
                                    Grid.Column="1"
                                    HorizontalOptions="Center"
                                    Padding="5,5"
                                    Text="Buscar"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="Center"
                                    />
                                <Button
                                    BackgroundColor="Gray"
                                    CornerRadius="8"
                                    FontSize="14"
                                    Grid.Column="2"
                                    HorizontalOptions="Center"
                                    Padding="5,5"
                                    Text="Filtrar"
                                    TextColor="#FFFFFF"
                                    VerticalOptions="Center"
                                    />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>


        </VerticalStackLayout>
        <Grid Grid.Row="2" Margin="10,10,10,0">
            <!-- FILTROS DINÁMICOS LIGEROS -->
            <CollectionView
                    
                    ItemsSource="{Binding Filters}"
                    ItemsLayout="HorizontalList"
                    HorizontalOptions="Fill"
                    SelectionMode="None"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,0,0,0">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskFilterOption">
                        <Border StrokeThickness="0"
                                Margin="0,0,10,0"
                                Padding="0"
                                HeightRequest="35"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#333847}">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
Command="{Binding Source={RelativeSource AncestorType={x:Type base:BasePage}}, Path=BindingContext.ChangeFilterCommand}"
CommandParameter="{Binding Filter}" />
                            </Border.GestureRecognizers>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
     Binding="{Binding IsSelected}"
     Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource primarioS}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Label Text="{Binding Title}"
   Padding="16,8"
   FontSize="13"
   FontAttributes="Bold"
   TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}">

                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
         Binding="{Binding IsSelected}"
         Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>


        <!-- TASK LIST -->
        <Grid Grid.Row="3" Margin="10,0,10,0">

            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No tienes tareas todavía"
                               HorizontalOptions="Center"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource White}}" />
                        <Label Text="Crea tu primera tarea para empezar."
                               HorizontalOptions="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- 2 cards por fila -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     VerticalItemSpacing="10"
                                     HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                StrokeShape="RoundRectangle 18"
                                MinimumHeightRequest="150">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
        CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                                  RowSpacing="4">

                                <!-- TOP BADGES -->
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">

                                    <Border Padding="8,4"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource shipsligth}, Dark={StaticResource DarkBackground}}"
                                            StrokeShape="RoundRectangle 12"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding PriorityText}"
                                               FontSize="10"
                                               FontFamily="LatoBold"
                                               TextColor="{Binding PriorityColorHex}" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding StatusText}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center"
                                           FontFamily="OpenSansRegular"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding StatusColorHex}" />
                                </Grid>

                                <!-- TITLE -->
                                <Label Grid.Row="1"
                                       Text="{Binding Title}"
                                       FontSize="13"
                                       FontFamily="MontserratSemiBold"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}" />

                                <!-- CONTENT -->
                                <VerticalStackLayout Grid.Row="3"
                                                     Spacing="6">

                                    <!-- Fecha principal -->
                                   
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="⏰"
                                                   FontSize="12" />
                                            <Label Text="{Binding DueDatePrimaryText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                        </HorizontalStackLayout>

                                    <!-- Fecha relativa -->
                                    <Label Text="{Binding DueDateRelativeText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding DueDateRelativeColorHex}"
                                           IsVisible="{Binding HasDueDateRelativeText}" />

                                    <!-- Tiempo estimado -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⏳"
                                               FontSize="12" />
                                        <Label Text="{Binding EstimatedMinutesText}"
                                               FontSize="12"
                                               FontFamily="MontserratRegular"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </HorizontalStackLayout>
                                    <!-- curso -->
                                    <Border IsVisible="{Binding HasCourse}"
                                         Padding="3"
                                         StrokeShape="RoundRectangle 10"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource shipsligth}, Dark={StaticResource DarkBackground}}">

                                        <HorizontalStackLayout Spacing="6">

                                            <BoxView WidthRequest="6"
                                                  HeightRequest="20"
                                                     CornerRadius="2"
                                                     Background="Transparent"
                                                  Color="{Binding CourseColor}" />
                                            <Label Text="Curso:"
                                                   FontSize="11"
                                                   FontFamily="MontserratRegular"
                                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                            <Label Text="{Binding CourseName}"
                                                FontSize="11"
                                                FontFamily="OpenSansRegular"
                                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <!-- Overdue -->
                                    <!--<Label Text="{Binding OverdueText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="#DC2626"
                                           IsVisible="{Binding ShowOverdue}" />-->


                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FAB FLOTANTE REAL (SUPERPUESTO, SIN RESERVAR ESPACIO) -->
            <Button Text="+"
                    Clicked="OnAddTaskClicked"
                    BackgroundColor="{StaticResource primarioS}"
                    TextColor="{StaticResource White}"
                    FontSize="28"
                    WidthRequest="70"
                    HeightRequest="70"
                    CornerRadius="40"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    ZIndex="10" />
        </Grid>

    </Grid>
</base:BasePage>