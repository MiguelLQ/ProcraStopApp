<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ProcraStop.Modules.Tasks.Presentation.Controls"
             xmlns:viewModels="clr-namespace:ProcraStop.Modules.Habits.Presentation.ViewModels"
             x:Class="ProcraStop.Modules.Habits.Presentation.Views.HabitAnalyticsPage"
             x:DataType="viewModels:HabitAnalyticsViewModel"
             Title="Análisis de hábitos"
             Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}"
            Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
            Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Spacing="8" Padding="0,0,0,28">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,40,40"
                        Padding="15,0,15,15">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hábitos completados durante los últimos 7 días"
                                       FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="#203A32"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding MomentumText}"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="11"
                                       TextColor="#5DDB9A" />
                            </Border>
                        </Grid>

                        <controls:TaskAnalyticsChart ChartType="Line"
                                                     Values="{Binding WeeklyValues}"
                                                     Labels="{Binding WeeklyLabels}"
                                                     HeightRequest="220" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalOptions="Center">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="COMPLETADOS ESTA SEMANA"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding CompletedThisWeek}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="PROGRAMADOS HOY"
                                       FontSize="10"
                                       FontFamily="MontserratSemiBold"
                                       TextColor="#91A0B6" />
                                <Label Text="{Binding ScheduledToday}"
                                       FontSize="24"
                                       FontFamily="MontserratSemiBold"
                                       HorizontalOptions="Center"
                                       TextColor="#F4B740" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                    <!--grafico pastel-->
                <Border  Padding="16">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Estado de hoy" FontFamily="MontserratSemiBold"
                                FontSize="18"/>
                        <Label Text="Cumplidos frente a pendientes del día" FontSize="14"
                                FontFamily="OpenSansRegular"
                                TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                        <controls:TaskAnalyticsChart ChartType="Donut"
                                                         Values="{Binding StatusValues}"
                                                         Labels="{Binding StatusLabels}"
                                                         HeightRequest="230" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Padding="15,-30,15,0" Spacing="8">
                    
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="15" RowSpacing="15">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Activos"  FontFamily="MontserratSemiBold"
                                    FontSize="18"/>
                                <Label Text="{Binding ActiveHabits}"  />
                                <Label Text="hábitos en seguimiento" FontSize="14"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}" >
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Constancia" FontFamily="MontserratSemiBold"
                                    FontSize="17"/>
                                <Label Text="{Binding ConsistencyText}"  TextColor="#34C77B" />
                                <Label Text="cumplimiento semanal"  FontSize="14"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="En riesgo" FontFamily="MontserratSemiBold"
                                    FontSize="17"/>
                                <Label Text="{Binding AtRiskHabits}"  TextColor="#EF5B5B" />
                                <Label Text="sin avance reciente"  FontSize="14"
                                        FontFamily="OpenSansRegular"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Mejor racha" FontFamily="MontserratSemiBold"
                                        FontSize="17"/>
                                <Label Text="{Binding BestStreak}"  TextColor="#4F8CFF" />
                                <Label Text="días consecutivos" FontSize="14"
                                    FontFamily="OpenSansRegular"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                     <!--indicadores-->
                    <Border  Padding="15,0,15,0" Background="Transparent" Margin="0,20,0,0">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Tipo de hábitos"  FontFamily="MontserratSemiBold"
                                    FontSize="18"/>
                            <Label Text="Balance entre hábitos binarios y medibles" 
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding TypeValues}"
                                                         Labels="{Binding TypeLabels}"
                                                         HeightRequest="140" />
                        </VerticalStackLayout>
                    </Border>

                    <Border  Padding="15,0,15,0" Background="Transparent">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Riesgo de abandono" FontFamily="MontserratSemiBold"
                                    FontSize="18"/>
                            <Label Text="Hábitos que conviene rescatar primero" 
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                    TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            <controls:TaskAnalyticsChart ChartType="Bars"
                                                         Values="{Binding RiskValues}"
                                                         Labels="{Binding RiskLabels}"
                                                         HeightRequest="140" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
