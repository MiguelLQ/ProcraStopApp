<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProcraStop.Modules.Habits.Presentation.Views.HabitDisciplineRankingPage"
             Title="Ranking de disciplina"
                Shell.BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                Shell.TitleColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
                Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Titlecl}, Dark={StaticResource Title}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="0,0,0,0">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,40,40"
                        Padding="15,0,15,15">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="10,0,10,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding HeadlineText}"
                                       FontFamily="OpenSansRegular"
                                       FontSize="16"
                                        TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="5,8"
                                    >
                                <HorizontalStackLayout HorizontalOptions="Center" >
                                    <Label Text="score"
                                           FontFamily="OpenSansRegular"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           Padding="5"
                                           TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    <Label Text="{Binding AverageScoreText}"
                                           FontFamily="MontserratSemiBold"
                                           FontSize="22"
                                           TextColor="#5DDB9A" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border  BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Activos" FontFamily="Monts erratSemiBold"
                                            FontSize="16"/>
                                    <Label Text="{Binding ActiveHabits}" FontAttributes="Bold" FontSize="22"  />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1"  BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Elite"  FontFamily="MontserratSemiBold"
                                            FontSize="16"/>
                                    <Label Text="{Binding EliteHabits}" FontAttributes="Bold" FontSize="22"   TextColor="#5DDB9A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2"  BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Riesgo" FontFamily="MontserratSemiBold"
                                            FontSize="16"/>
                                    <Label Text="{Binding AtRiskHabits}" FontAttributes="Bold" FontSize="22" TextColor="#FF7777" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <!--ranking-->
                <VerticalStackLayout Margin="10,-10,10,0" Spacing="8">
                    <Border BackgroundColor="Transparent"
                            IsVisible="{Binding HasRanking}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Podio actual" FontFamily="MontserratSemiBold"
                                            FontSize="18"/>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#F4FFF8, Dark=#172B24}"
                                        Stroke="#34C77B"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="12">
                                    <VerticalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center" >
                                        <Label Text="#1"  TextColor="#34C77B" HorizontalOptions="Center"/>
                                        <Label Text="{Binding FirstPlace.Name}" HorizontalTextAlignment="Center" FontFamily="MontserratSemiBold"
                                            FontSize="14" />
                                        <Label Text="{Binding FirstPlace.ScoreText}"  TextColor="#34C77B" 
                                               FontFamily="MontserratSemiBold"
                                               HorizontalOptions="Center" FontSize="22"/>
                                        <Label Text="{Binding FirstPlace.Status}"  HorizontalTextAlignment="Center" FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="0"
                                        Margin="0,16,0,0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                       >
                                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="#2" HorizontalOptions="Center"/>
                                        <Label Text="{Binding SecondPlace.Name}"  HorizontalTextAlignment="Center" FontFamily="MontserratSemiBold"
                                            FontSize="12"  />
                                        <Label Text="{Binding SecondPlace.ScoreText}"   FontFamily="MontserratSemiBold"
                                               HorizontalOptions="Center" FontSize="22"/>
                                        <Label Text="{Binding SecondPlace.Status}" HorizontalTextAlignment="Center" FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="2"
                                        Margin="0,28,0,0"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                        >
                                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                        <Label Text="#3" HorizontalOptions="Center" />
                                        <Label Text="{Binding ThirdPlace.Name}" HorizontalTextAlignment="Center" FontFamily="MontserratSemiBold"
                                            FontSize="12"  />
                                        <Label Text="{Binding ThirdPlace.ScoreText}" FontFamily="MontserratSemiBold"
                                               HorizontalOptions="Center" FontSize="22"/>
                                        <Label Text="{Binding ThirdPlace.Status}" HorizontalTextAlignment="Center" FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <!--desempeño-->
                    <Border  StrokeThickness="0"
                         StrokeShape="RoundRectangle 40,40,0,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource shellDark}}">
                        <VerticalStackLayout Spacing="12" Margin="10,0,10,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="Tabla de desempeño"  FontFamily="MontserratSemiBold"
                        FontSize="18" />
                                <Label Grid.Column="1"
                                       Text="14 días"
                                       FontFamily="MontserratSemiBold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#4F8CFF, Dark=#8DB3FF}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Ranking}"
                                SelectionMode="None"
                                EmptyView="Aún no hay hábitos activos para rankear.">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
         
                                            Padding="0,10,0,0"
                                            Margin="0,0,0,0">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border WidthRequest="38"
                                                        HeightRequest="38"
                                                            Padding="0"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{Binding AccentColor}"
                                                        StrokeShape="RoundRectangle 8">
                                                        <Label Text="{Binding PositionText}"
                                                           FontFamily="MontserratSemiBold"
                                                           FontSize="12"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}"
                                                           FontFamily="MontserratSemiBold"
                                                           FontSize="15"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light=#111827, Dark=#F4F7FB}" />
                                                    <Label Text="{Binding ProgressText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"
                                                    />
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="2" Spacing="0" HorizontalOptions="End">
                                                        <Label Text="{Binding ScoreText}"
                                                           FontFamily="MontserratSemiBold"
                                                           FontSize="22"
                                                           HorizontalTextAlignment="End"
                                                           TextColor="{Binding AccentColor}" />
                                                        <Label Text="{Binding Status}"
                                                           FontFamily="OpenSansRegular"
                                                           FontSize="10"
                                                           HorizontalTextAlignment="End"
                                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#91A0B6}" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <ProgressBar Progress="{Binding ScoreProgress}"
                                                     HeightRequest="6"
                                                     ProgressColor="{Binding AccentColor}"
                                                     BackgroundColor="{AppThemeBinding Light=#E6EAF0, Dark=#263246}" />

                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                    <VerticalStackLayout Spacing="1">
                                                    <Label Text="Constancia" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                                    <Label Text="{Binding ConsistencyText}" FontSize="13" FontFamily="MontserratSemiBold"  />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="Racha"  FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}" />
                                                    <Label Text="{Binding StreakText}" FontSize="13" FontFamily="MontserratSemiBold" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                                                    <Label Text="Tendencia"   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Subtitlecl}, Dark={StaticResource Subtitle}}"/>
                                                    <Label Text="{Binding TrendText}"  FontSize="13" FontFamily="MontserratSemiBold"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                                <BoxView 
                                                     HeightRequest="1"
                                                     Color="{AppThemeBinding Light={StaticResource EntryClar}, Dark={StaticResource EntryDark}}"
                                                     />
                                            </VerticalStackLayout>

                                        </Border>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
